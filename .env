# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
SESSION_SECRET=jkvndksvnkd

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_NAME=et24jobs
# DB_NAME=etjobsc1_et24jobs
DB_USER=admin
# DB_USER=etjobsc1_admin
DB_PASSWORD=admin
# DB_PASSWORD=G&i!x[6KlIm$6LUc
DB_HOST=localhost
# DB_HOST=11.138.0.18
DB_PORT=3306

# ---------------------------------------------------------------------------
# Site URLs
# ---------------------------------------------------------------------------
# Public base URL of the app (job links + attachment URL builder if no
# dedicated storage URL is configured).
PUBLIC_BASE_URL=https://et24jobs.com/

# ---------------------------------------------------------------------------
# Cloudflare Object Storage (R2 / S3-compatible)
# Used ONLY for direct-from-browser uploads. The backend does not receive
# image bytes for create/edit anymore.
# ---------------------------------------------------------------------------
# Whether direct-to-storage uploads are enabled at all. If false, the app
# falls back to the old local-disk multer path.
CLOUDFLARE_UPLOAD_ENABLED=true

# Storage scheme + public URL that the browser will upload to / read from.
# Examples:
#   http://127.0.0.1:9000  (local MinIO for staging)
#   https://<account>.r2.cloudflarestorage.com  (R2 direct)
#   https://<bucket>.<zone>.cloudflarecdn.net     (R2 behind CDN, if used)
CLOUDFLARE_STORAGE_SCHEME=https
CLOUDFLARE_STORAGE_HOST=https://c07d7b079fbdf488693d21a1bb631090.eu.r2.cloudflarestorage.com/et24jobs
CLOUDFLARE_STORAGE_BUCKET=et24jobs
CLOUDFLARE_STORAGE_PREFIX=jobs

# Credentials for creating pre-signed upload URLs server-side.
# If you want the backend to create those URLs, these are required.
# (If your bucket is fully public-write and you prefer that, set
# CLOUDFLARE_UPLOAD_VIA_PRESIGNED=false and keep only the public URL vars.)
CLOUDFLARE_ACCESS_KEY_ID=3fd4bb767653b29e5e8aad4c7533fa92
CLOUDFLARE_SECRET_ACCESS_KEY=78609aad6f1ef54bdf0f9de67330fa99d51c12ac6dd372b8f019030046dff597
CLOUDFLARE_UPLOAD_VIA_PRESIGNED=true

# How long pre-signed upload URLs are valid, in seconds.
CLOUDFLARE_UPLOAD_URL_TTL_SECONDS=3600

# Public read URL for an object, used by the website and Telegram.
# If your bucket is private and you use signed URLs, leave this empty and
# the app will fall back to generating temporary signed URLs via
# CLOUDFLARE_ACCESS_KEY_ID / CLOUDFLARE_SECRET_ACCESS_KEY.
CLOUDFLARE_PUBLIC_OBJECT_BASE_URL=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Leave empty to disable the Telegram feature.
TELEGRAM_BOT_TOKEN=8927855022:AAGNjhJcgGQXdIynK_nzj4DD7z_r3tdAS7Y
TELEGRAM_CHANNEL_ID=@et24jobs

# Base URL Telegram uses to DOWNLOAD photos for a post (sendPhoto /
# sendMediaGroup). If empty, falls back to PUBLIC_BASE_URL, then to "".
# When empty or not publicly reachable, photos are uploaded as bytes.
# IMAGE_BASE_URL=http://192.168.0.80:3000/jobs/

# ---------------------------------------------------------------------------
# Admin creation (one-shot script)
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Dere-Admin-2024

# ---------------------------------------------------------------------------
# Cloudflare R2 account info (kept from your previous .envl)
# Used by your own scripts/notes if needed; the upload service above uses
# CLOUDFLARE_ACCESS_KEY_ID / CLOUDFLARE_SECRET_ACCESS_KEY / BUCKET.
# ---------------------------------------------------------------------------
# R2_ACCOUNT_ID=c07d7b079fbdf488693d21a1bb631090
# R2_BUCKET_NAME=et24jobs

# ---------------------------------------------------------------------------
# Job attachment limits
# Source of truth for both the job validation layer and the Cloudflare config
# layer. If you change these, update the client-side validation messages too.
# ---------------------------------------------------------------------------
JOB_ATTACHMENT_MAX_FILES=5
JOB_ATTACHMENT_MAX_SIZE_BYTES=10485760
