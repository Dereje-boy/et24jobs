<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{#if pageTitle}}<title>{{pageTitle}} | ET24Jobs</title>{{else}}<title>ET24Jobs | Find jobs, scholarships and internships</title>{{/if}}
    {{#if pageDescription}}<meta name="description" content="{{pageDescription}}" />{{/if}}
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Ad scripts (verbatim, copied from views/index.handlebars lines 4-5; identical on every public page) -->
    <script>(function(s){s.dataset.zone='12227331',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <script>(function(s){s.dataset.zone='12229545',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    {{#if pageCss}}<link rel="stylesheet" href="/css/pages/{{pageCss}}" />{{/if}}
    {{#if extraStyles}}<style>{{extraStyles}}</style>{{/if}}
  </head>
  <body>
    {{> navbar}}
    {{{body}}}
    {{#ifCond (eq layout 'main') true}}
    <footer class="site-footer">
      <div class="container">
        <div class="row g-4">
          <div class="col-md-5">
            <h5>ET24Jobs</h5>
            <p class="mt-3">Helping job seekers, students and professionals discover jobs, scholarships and internship opportunities.</p>
          </div>
          <div class="col-md-3">
            <h5>Explore</h5>
            <ul class="list-unstyled mt-3">
              <li class="mb-2"><a href="/jobs">Jobs</a></li>
              <li class="mb-2"><a href="/scholarships">Scholarships</a></li>
              <li><a href="/internships">Internships</a></li>
            </ul>
          </div>
          <div class="col-md-4">
            <h5>Information</h5>
            <ul class="list-unstyled mt-3">
              <li class="mb-2"><a href="/about">About Us</a></li>
              <li class="mb-2"><a href="/contact">Contact Us</a></li>
              <li class="mb-2"><a href="/privacy-policy">Privacy Policy</a></li>
              <li><a href="/terms">Terms & Conditions</a></li>
            </ul>
          </div>
        </div>
        <hr class="border-secondary my-4" />
        <div class="text-center"><small>© 2026 ET24Jobs. All rights reserved.</small></div>
      </div>
    </footer>
    {{/ifCond}}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
