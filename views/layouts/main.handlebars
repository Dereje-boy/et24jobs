    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    {{!-- <title>ET24Jobs - Jobs, Scholarships & Internship</title> --}}

    <meta
      name="description"
      content="Find the latest jobs, scholarships and internships on ET24Jobs."
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    
    <style>
      /* =====================================
           GLOBAL
        ===================================== */

      body {
        background: #f5f7fb;

        font-family: Arial, Helvetica, sans-serif;

        color: #1f2937;
      }

      /* =====================================
           NAVBAR
        ===================================== */

      .navbar {
        background: #ffffff;

        border-bottom: 1px solid #e5e7eb;
      }

      .navbar-brand {
        font-size: 1.45rem;

        font-weight: 800;

        color: #2563eb !important;
      }

      .navbar-brand span {
        color: #111827;
      }

      .nav-link {
        color: #374151 !important;

        font-weight: 500;

        margin-left: 10px;
      }

      .nav-link:hover,
      .nav-link.active {
        color: #2563eb !important;
      }


      /* =====================================
           HERO
        ===================================== */

        
  .jobs-hero {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);

    color: white;

    padding: 55px 20px;

    border-radius: 0 0 25px 25px;
  }

  .jobs-hero h1 {
    font-size: 2.4rem;
    font-weight: 800;
  }

  .jobs-hero p {
    max-width: 650px;
    margin: 15px auto 0;
    opacity: 0.92;
    font-size: 1.05rem;
  }

  /* =========================
           SEARCH
        ========================= */

  .search-box {
    margin-top: -25px;
    position: relative;
    z-index: 5;
  }

  .search-card {
    background: white;
    border-radius: 15px;
    padding: 18px;

    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .search-input {
    border: 1px solid #d1d5db;
    border-radius: 10px;
    height: 48px;
  }

  .search-button {
    height: 48px;
    border-radius: 10px;
    font-weight: 600;
  }

  /* =========================
           SECTION
        ========================= */

  .section-title {
    font-weight: 800;
    color: #111827;
  }

  .result-count {
    color: #6b7280;
  }

      .hero {
        background: linear-gradient(135deg, #eff6ff, #ffffff);

        border-bottom: 1px solid #e5e7eb;

        padding: 65px 20px 70px;
      }

      .hero-title {
        font-size: 2.8rem;

        font-weight: 800;

        color: #edf1fa;

        line-height: 1.15;
      }

      .hero-title span {
        color: #03eeb3;
      }

      .hero-text {
        max-width: 700px;

        margin: 18px auto 30px;

        color: #ffffff;

        font-size: 1.05rem;

        line-height: 1.7;
      }


      /* =====================================
           SECTION
        ===================================== */

      .section {
        margin-top: 50px;
      }

      .section-heading {
        font-size: 1.55rem;

        font-weight: 800;

        color: #111827;
      }

      .section-description {
        color: #6b7280;

        font-size: 0.92rem;
      }

      .view-all {
        font-size: 0.9rem;

        font-weight: 600;

        text-decoration: none;

        color: #2563eb;
      }

      .view-all:hover {
        text-decoration: underline;
      }

      /* =====================================
           JOB CARD
        ===================================== */

      .opportunity-card {
        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 14px;

        padding: 20px;

        height: 100%;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .opportunity-card:hover {
        transform: translateY(-3px);

        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
      }

      .card-icon {
        width: 46px;

        height: 46px;

        border-radius: 11px;

        background: #eff6ff;

        color: #2563eb;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 1.2rem;

        flex-shrink: 0;
      }

      .card-title {
        font-weight: 750;

        font-size: 1rem;

        color: #111827;

        line-height: 1.4;

        text-decoration: none;
      }

      .card-title:hover {
        color: #2563eb;
      }

      .company-name {
        color: #6b7280;

        font-size: 0.84rem;

        margin-top: 4px;
      }

      .card-info {
        color: #6b7280;

        font-size: 0.82rem;

        margin-top: 14px;
      }

      .card-info div {
        margin-bottom: 5px;
      }

      .card-badge {
        display: inline-block;

        padding: 5px 9px;

        border-radius: 20px;

        background: #eff6ff;

        color: #1d4ed8;

        font-size: 0.72rem;

        font-weight: 600;
      }

      .card-badge.green {
        background: #f0fdf4;

        color: #15803d;
      }

      .card-badge.purple {
        background: #faf5ff;

        color: #7e22ce;
      }

      .card-badge.red {
        background: #fef2f2;

        color: #dc2626;
      }

      /* =====================================
           FEATURED BANNER
        ===================================== */

      .feature-banner {
        background: linear-gradient(135deg, #1d4ed8, #2563eb);

        border-radius: 18px;

        padding: 35px;

        color: white;
      }

      .feature-banner h2 {
        font-weight: 800;
      }

      .feature-banner p {
        color: #dbeafe;

        max-width: 650px;
      }

      .feature-button {
        background: #ffffff;

        color: #1d4ed8;

        font-weight: 700;

        border-radius: 9px;

        padding: 10px 18px;
      }

      /* =====================================
           FOOTER
        ===================================== */

      footer {
        background: #111827;

        color: #9ca3af;

        margin-top: 70px;

        padding: 45px 20px;
      }

      footer h5 {
        color: #ffffff;

        font-weight: 700;
      }

      footer a {
        color: #9ca3af;

        text-decoration: none;
      }

      footer a:hover {
        color: #ffffff;
      }

      /* =====================================
           MOBILE
        ===================================== */

      @media (max-width: 768px) {
        .hero {
          padding: 45px 15px 50px;
        }

        .hero-title {
          font-size: 2rem;
        }

        .search-box {
          padding: 6px;
        }

        .search-button {
          width: 100%;

          margin-top: 5px;
        }

        .feature-banner {
          padding: 25px;
        }
      }
    </style>


  </head>

  <body>

{{!-- Navbar --}}
 {{> header}}

{{!-- Main Embedded content --}}
{{{body}}}



{{!-- Footer --}}
{{> footer}}

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>

</html>