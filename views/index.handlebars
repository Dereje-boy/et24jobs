<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ET24Jobs - Jobs, Scholarships & Internships</title>

    <meta
      name="description"
      content="Find the latest jobs, scholarships and internships on ET24Jobs."
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      /* =====================================
           GLOBAL
        ===================================== */

      body {
        background: #f5f7fb;

        font-family: Arial, Helvetica, sans-serif;

        color: #1f2937;
      }

      /* =====================================
           NAVBAR
        ===================================== */

      .navbar {
        background: #ffffff;

        border-bottom: 1px solid #e5e7eb;
      }

      .navbar-brand {
        font-size: 1.45rem;

        font-weight: 800;

        color: #2563eb !important;
      }

      .navbar-brand span {
        color: #111827;
      }

      .nav-link {
        color: #374151 !important;

        font-weight: 500;

        margin-left: 10px;
      }

      .nav-link:hover,
      .nav-link.active {
        color: #2563eb !important;
      }

      /* =====================================
           HERO
        ===================================== */

      .hero {
        background: linear-gradient(135deg, #eff6ff, #ffffff);

        border-bottom: 1px solid #e5e7eb;

        padding: 65px 20px 70px;
      }

      .hero-title {
        font-size: 2.8rem;

        font-weight: 800;

        color: #111827;

        line-height: 1.15;
      }

      .hero-title span {
        color: #2563eb;
      }

      .hero-text {
        max-width: 700px;

        margin: 18px auto 30px;

        color: #6b7280;

        font-size: 1.05rem;

        line-height: 1.7;
      }

      /* =====================================
           SEARCH
        ===================================== */

      .search-box {
        max-width: 850px;

        margin: auto;

        background: #ffffff;

        border: 1px solid #dbe2ea;

        border-radius: 14px;

        padding: 8px;

        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
      }

      .search-box input {
        border: none;

        box-shadow: none;

        padding: 13px;
      }

      .search-box input:focus {
        box-shadow: none;
      }

      .search-button {
        border-radius: 10px;

        padding: 12px 24px;

        font-weight: 700;
      }

      /* =====================================
           ADVERTISEMENT
        ===================================== */

      .ad-box {
        min-height: 90px;

        background: #ffffff;

        border: 1px dashed #d1d5db;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #9ca3af;

        font-size: 0.8rem;
      }

      /* =====================================
           SECTION
        ===================================== */

      .section {
        margin-top: 50px;
      }

      .section-heading {
        font-size: 1.55rem;

        font-weight: 800;

        color: #111827;
      }

      .section-description {
        color: #6b7280;

        font-size: 0.92rem;
      }

      .view-all {
        font-size: 0.9rem;

        font-weight: 600;

        text-decoration: none;

        color: #2563eb;
      }

      .view-all:hover {
        text-decoration: underline;
      }

      /* =====================================
           JOB CARD
        ===================================== */

      .opportunity-card {
        background: #ffffff;

        border: 1px solid #e5e7eb;

        border-radius: 14px;

        padding: 20px;

        height: 100%;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .opportunity-card:hover {
        transform: translateY(-3px);

        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.07);
      }

      .card-icon {
        width: 46px;

        height: 46px;

        border-radius: 11px;

        background: #eff6ff;

        color: #2563eb;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 1.2rem;

        flex-shrink: 0;
      }

      .card-title {
        font-weight: 750;

        font-size: 1rem;

        color: #111827;

        line-height: 1.4;

        text-decoration: none;
      }

      .card-title:hover {
        color: #2563eb;
      }

      .company-name {
        color: #6b7280;

        font-size: 0.84rem;

        margin-top: 4px;
      }

      .card-info {
        color: #6b7280;

        font-size: 0.82rem;

        margin-top: 14px;
      }

      .card-info div {
        margin-bottom: 5px;
      }

      .card-badge {
        display: inline-block;

        padding: 5px 9px;

        border-radius: 20px;

        background: #eff6ff;

        color: #1d4ed8;

        font-size: 0.72rem;

        font-weight: 600;
      }

      .card-badge.green {
        background: #f0fdf4;

        color: #15803d;
      }

      .card-badge.purple {
        background: #faf5ff;

        color: #7e22ce;
      }

      .card-badge.red {
        background: #fef2f2;

        color: #dc2626;
      }

      /* =====================================
           FEATURED BANNER
        ===================================== */

      .feature-banner {
        background: linear-gradient(135deg, #1d4ed8, #2563eb);

        border-radius: 18px;

        padding: 35px;

        color: white;
      }

      .feature-banner h2 {
        font-weight: 800;
      }

      .feature-banner p {
        color: #dbeafe;

        max-width: 650px;
      }

      .feature-button {
        background: #ffffff;

        color: #1d4ed8;

        font-weight: 700;

        border-radius: 9px;

        padding: 10px 18px;
      }

      /* =====================================
           FOOTER
        ===================================== */

      footer {
        background: #111827;

        color: #9ca3af;

        margin-top: 70px;

        padding: 45px 20px;
      }

      footer h5 {
        color: #ffffff;

        font-weight: 700;
      }

      footer a {
        color: #9ca3af;

        text-decoration: none;
      }

      footer a:hover {
        color: #ffffff;
      }

      /* =====================================
           MOBILE
        ===================================== */

      @media (max-width: 768px) {
        .hero {
          padding: 45px 15px 50px;
        }

        .hero-title {
          font-size: 2rem;
        }

        .search-box {
          padding: 6px;
        }

        .search-button {
          width: 100%;

          margin-top: 5px;
        }

        .feature-banner {
          padding: 25px;
        }
      }
    </style>

  </head>

  <body>

    <!-- =====================================
     NAVBAR
===================================== -->

    <nav class="navbar navbar-expand-lg">

      <div class="container">

        <a class="navbar-brand" href="/">

          ET24<span>Jobs</span>

        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >

          <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

          <ul class="navbar-nav ms-auto">

            <li class="nav-item">

              <a class="nav-link active" href="/Admin/login">

                Admin

              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/jobs">

                Jobs

              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/scholarships">

                Scholarships

              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/internships">

                Internships

              </a>

            </li>

          </ul>

        </div>

      </div>

    </nav>

    <!-- =====================================
     HERO
===================================== -->

    <section class="hero text-center">

      <div class="container">

        <h1 class="hero-title">

          Find Your Next

          <span>

            Opportunity

          </span>

        </h1>

        <p class="hero-text">

          Discover the latest jobs, scholarships and internships from Ethiopia
          and around the world — all in one place.

        </p>

        <!-- SEARCH -->

        <form action="/search" method="GET" class="search-box">

          <div class="row g-2 align-items-center">

            <div class="col-md">

              <input
                type="text"
                name="q"
                class="form-control"
                placeholder="Search jobs, scholarships, internships..."
              />

            </div>

            <div class="col-md-auto">

              <button type="submit" class="btn btn-primary search-button">

                <i class="bi bi-search"></i>

                Search

              </button>

            </div>

          </div>

        </form>

      </div>

    </section>

    <!-- =====================================
     MAIN
===================================== -->

    <main class="container">

      <!-- TOP AD -->

      <!-- =====================================
         LATEST JOBS
    ===================================== -->

      <section class="section">

        <div class="d-flex justify-content-between align-items-end mb-3">

          <div>

            <h2 class="section-heading mb-1">

              Latest Jobs

            </h2>

            <p class="section-description mb-0">

              Recently posted employment opportunities.

            </p>

          </div>

          <a href="/jobs" class="view-all">

            View All Jobs

            <i class="bi bi-arrow-right"></i>

          </a>

        </div>

        <div class="row g-4">

          {{#if latestJobs.length}}

            {{#each latestJobs}}

              <div class="col-md-6 col-lg-4">

                <article class="opportunity-card">

                  <div class="d-flex gap-3">

                    <div class="card-icon">

                      <i class="bi bi-briefcase-fill"></i>

                    </div>

                    <div class="flex-grow-1">

                      <a href="/jobs/{{slug}}" class="card-title">

                        {{title}}

                      </a>

                      <div class="company-name">

                        <i class="bi bi-building"></i>

                        {{companyName}}

                      </div>

                    </div>

                  </div>

                  <div class="card-info">

                    {{#if location}}

                      <div>

                        <i class="bi bi-geo-alt"></i>

                        {{location}}

                      </div>

                    {{/if}}

                    {{#if employmentType}}

                      <div>

                        <i class="bi bi-clock"></i>

                        {{employmentType}}

                      </div>

                    {{/if}}

                  </div>

                  <div class="mt-3">

                    {{#if category}}

                      <span class="card-badge">

                        {{category.name}}

                      </span>

                    {{/if}}

                    {{#if deadline}}

                      {{#if (isExpired deadline)}}

                        <span class="card-badge red">

                          <i class="bi bi-calendar-x"></i>
                          Deadline passed

                        </span>

                      {{else}}

                        <span class="card-badge green">

                          <i class="bi bi-hourglass-split"></i>

                          {{#if (eq (daysRemaining deadline) 0)}}
                            Closes today!
                          {{else}}
                            {{daysRemaining deadline}}
                            day{{#unless
                              (eq (daysRemaining deadline) 1)
                            }}s{{/unless}}
                            left
                          {{/if}}

                        </span>

                      {{/if}}

                    {{/if}}

                  </div>

                </article>

              </div>

            {{/each}}

          {{else}}

            <div class="col-12">

              <div class="alert alert-light border">

                No jobs are currently available.

              </div>

            </div>

          {{/if}}

        </div>

      </section>

      <!-- AD -->

      <!-- =====================================
         LATEST SCHOLARSHIPS
    ===================================== -->

      <section class="section">

        <div class="d-flex justify-content-between align-items-end mb-3">

          <div>

            <h2 class="section-heading mb-1">

              Latest Scholarships

            </h2>

            <p class="section-description mb-0">

              Scholarship opportunities for students and professionals.

            </p>

          </div>

          <a href="/scholarships" class="view-all">

            View All Scholarships

            <i class="bi bi-arrow-right"></i>

          </a>

        </div>

        <div class="row g-4">

          {{#if latestScholarships.length}}

            {{#each latestScholarships}}

              <div class="col-md-6 col-lg-4">

                <article class="opportunity-card">

                  <div class="d-flex gap-3">

                    <div class="card-icon">

                      <i class="bi bi-mortarboard-fill"></i>

                    </div>

                    <div class="flex-grow-1">

                      <a href="/scholarships/{{slug}}" class="card-title">

                        {{title}}

                      </a>

                      <div class="company-name">

                        <i class="bi bi-building"></i>

                        {{providerName}}

                      </div>

                    </div>

                  </div>

                  <div class="card-info">

                    {{#if location}}

                      <div>

                        <i class="bi bi-geo-alt"></i>

                        {{location}}

                      </div>

                    {{/if}}

                    {{#if studyLevel}}

                      <div>

                        <i class="bi bi-mortarboard"></i>

                        {{studyLevel}}

                      </div>

                    {{/if}}

                  </div>

                  <div class="mt-3">

                    {{#if fieldOfStudy}}

                      <span class="card-badge purple">

                        {{fieldOfStudy}}

                      </span>

                    {{/if}}

                    {{#if deadline}}

                      <span class="card-badge green">

                        Deadline:
                        {{deadline}}

                      </span>

                    {{/if}}

                  </div>

                </article>

              </div>

            {{/each}}

          {{else}}

            <div class="col-12">

              <div class="alert alert-light border">

                No scholarships are currently available.

              </div>

            </div>

          {{/if}}

        </div>

      </section>

      <!-- AD -->

      <!-- =====================================
         LATEST INTERNSHIPS
    ===================================== -->

      <section class="section">

        <div class="d-flex justify-content-between align-items-end mb-3">

          <div>

            <h2 class="section-heading mb-1">

              Latest Internships

            </h2>

            <p class="section-description mb-0">

              Build your experience with internship opportunities.

            </p>

          </div>

          <a href="/internships" class="view-all">

            View All Internships

            <i class="bi bi-arrow-right"></i>

          </a>

        </div>

        <div class="row g-4">

          {{#if latestInternships.length}}

            {{#each latestInternships}}

              <div class="col-md-6 col-lg-4">

                <article class="opportunity-card">

                  <div class="d-flex gap-3">

                    <div class="card-icon">

                      <i class="bi bi-person-workspace"></i>

                    </div>

                    <div class="flex-grow-1">

                      <a href="/internships/{{slug}}" class="card-title">

                        {{title}}

                      </a>

                      <div class="company-name">

                        <i class="bi bi-building"></i>

                        {{organizationName}}

                      </div>

                    </div>

                  </div>

                  <div class="card-info">

                    {{#if location}}

                      <div>

                        <i class="bi bi-geo-alt"></i>

                        {{location}}

                      </div>

                    {{/if}}

                    {{#if internshipType}}

                      <div>

                        <i class="bi bi-clock"></i>

                        {{internshipType}}

                      </div>

                    {{/if}}

                    {{#if duration}}

                      <div>

                        <i class="bi bi-calendar3"></i>

                        {{duration}}

                      </div>

                    {{/if}}

                  </div>

                  <div class="mt-3">

                    {{#if fieldOfStudy}}

                      <span class="card-badge purple">

                        {{fieldOfStudy}}

                      </span>

                    {{/if}}

                    {{#if deadline}}

                      <span class="card-badge green">

                        Deadline:
                        {{deadline}}

                      </span>

                    {{/if}}

                  </div>

                </article>

              </div>

            {{/each}}

          {{else}}

            <div class="col-12">

              <div class="alert alert-light border">

                No internships are currently available.

              </div>

            </div>

          {{/if}}

        </div>

      </section>

      <!-- =====================================
         FEATURED SECTION
    ===================================== -->

      <section class="section">

        <div class="feature-banner">

          <div class="row align-items-center">

            <div class="col-lg-8">

              <h2>

                Don't Miss Your Next Opportunity

              </h2>

              <p class="mb-0 mt-2">

                Explore all available jobs, scholarships and internships and
                find an opportunity that matches your goals.

              </p>

            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

              <a href="/jobs" class="btn feature-button">

                Explore Opportunities

                <i class="bi bi-arrow-right"></i>

              </a>

            </div>

          </div>

        </div>

      </section>

      <!-- BOTTOM AD -->

      <!-- =====================================
     ABOUT ET24JOBS
===================================== -->

      <section class="section">

        <div class="row justify-content-center">

          <div class="col-lg-9">

            <div class="content-card text-center">

              <h2 class="section-heading mb-3">
                About ET24Jobs
              </h2>

              <p class="section-description mb-3">

                ET24Jobs is an online opportunities platform that helps job
                seekers, students and professionals discover jobs, scholarships
                and internship opportunities in Ethiopia and around the world.

              </p>

              <p class="section-description mb-0">

                We organize opportunities from available sources into an
                easy-to-browse platform, helping visitors find relevant
                opportunities and access the original application information.

              </p>

              <div class="mt-4">

                <a href="/about" class="btn btn-outline-primary">

                  Learn More About ET24Jobs

                  <i class="bi bi-arrow-right"></i>

                </a>

              </div>

            </div>

          </div>

        </div>

      </section>

    </main>

    <!-- =====================================
     FOOTER
===================================== -->

    <footer>

      <div class="container">

        <div class="row g-4">

          <!-- BRAND -->

          <div class="col-md-5">

            <h5>
              ET24Jobs
            </h5>

            <p class="mt-3">

              ET24Jobs helps job seekers, students and professionals discover
              jobs, scholarships and internship opportunities.

            </p>

          </div>

          <!-- EXPLORE -->

          <div class="col-md-3">

            <h5>
              Explore
            </h5>

            <ul class="list-unstyled mt-3">

              <li class="mb-2">
                <a href="/jobs">
                  Jobs
                </a>
              </li>

              <li class="mb-2">
                <a href="/scholarships">
                  Scholarships
                </a>
              </li>

              <li>
                <a href="/internships">
                  Internships
                </a>
              </li>

            </ul>

          </div>

          <!-- INFORMATION -->

          <div class="col-md-4">

            <h5>
              Information
            </h5>

            <ul class="list-unstyled mt-3">

              <li class="mb-2">
                <a href="/about">
                  About Us
                </a>
              </li>

              <li class="mb-2">
                <a href="/contact">
                  Contact Us
                </a>
              </li>

              <li class="mb-2">
                <a href="/privacy-policy">
                  Privacy Policy
                </a>
              </li>

              <li class="mb-2">
                <a href="/terms">
                  Terms & Conditions
                </a>
              </li>

            </ul>

          </div>

        </div>

        <hr class="border-secondary my-4" />

        <div class="text-center">

          <small>

            © 2026 ET24Jobs. All rights reserved.

          </small>

        </div>

      </div>

    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>

</html>