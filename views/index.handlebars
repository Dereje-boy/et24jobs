{{! Hero Section }}
<section class="jobs-hero text-center">

  <div class="container">

    <h1 class="hero-title">

      Find Your Next


        Opportunity

    </h1>
    </h1>
<p class="hero-text">

          Discover the latest jobs, scholarships and internships from Ethiopia
          and around the world — all in one place.

        </p>
  </div>

</section>

{{! Search }}
<div class="container search-box">

  <div class="search-card">

    <form action="/search" method="GET">

      <div class="row g-2">

        <div class="col-md-9">

          <input
            type="text"
            name="q"  
            class="form-control search-input"
            placeholder="Search jobs, scholarships, internships..."
            value="{{searchQuery}}"
          />

        </div>

        <div class="col-md-3">

          <button type="submit" class="btn btn-primary w-100 search-button">

            <i class="bi bi-search"></i>

            Search

          </button>

        </div>

      </div>

    </form>

  </div>

</div>

<main class="container">

  <!-- TOP AD -->

  <!-- =====================================
         LATEST JOBS
    ===================================== -->

  <section class="section">

    <div class="d-flex justify-content-between align-items-end mb-3">

      <div>

        <h2 class="section-heading mb-1">

          Latest Jobs

        </h2>

        <p class="section-description mb-0">

          Recently posted employment opportunities.

        </p>

      </div>

      <a href="/jobs" class="view-all">

        View All Jobs

        <i class="bi bi-arrow-right"></i>

      </a>

    </div>

    <div class="row g-4">

      {{#if latestJobs.length}}

        {{#each latestJobs}}

          <div class="col-md-6 col-lg-4">

            <article class="opportunity-card">

              <div class="d-flex gap-3">

                <div class="card-icon">

                  <i class="bi bi-briefcase-fill"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/jobs/{{slug}}" class="card-title">

                    {{title}}

                  </a>

                  <div class="company-name">

                    <i class="bi bi-building"></i>

                    {{companyName}}

                  </div>

                </div>

              </div>

              <div class="card-info">

                {{#if location}}

                  <div>

                    <i class="bi bi-geo-alt"></i>

                    {{location}}

                  </div>

                {{/if}}

                {{#if employmentType}}

                  <div>

                    <i class="bi bi-clock"></i>

                    {{employmentType}}

                  </div>

                {{/if}}

              </div>

              <div class="mt-3">

                {{#if category}}

                  <span class="card-badge">

                    {{category.name}}

                  </span>

                {{/if}}

                {{#if deadline}}

                  {{#if (isExpired deadline)}}

                    <span class="card-badge red">

                      <i class="bi bi-calendar-x"></i>
                      Deadline passed

                    </span>

                  {{else}}

                    <span class="card-badge green">

                      <i class="bi bi-hourglass-split"></i>

                      {{#if (eq (daysRemaining deadline) 0)}}
                        Closes today!
                      {{else}}
                        {{daysRemaining deadline}}
                        day{{#unless
                          (eq (daysRemaining deadline) 1)
                        }}s{{/unless}}
                        left
                      {{/if}}

                    </span>

                  {{/if}}

                {{/if}}

              </div>

            </article>

          </div>

        {{/each}}

      {{else}}

        <div class="col-12">

          <div class="alert alert-light border">

            No jobs are currently available.

          </div>

        </div>

      {{/if}}

    </div>

  </section>

  <!-- AD -->

  <!-- =====================================
         LATEST SCHOLARSHIPS
    ===================================== -->

  <section class="section">

    <div class="d-flex justify-content-between align-items-end mb-3">

      <div>

        <h2 class="section-heading mb-1">

          Latest Scholarships

        </h2>

        <p class="section-description mb-0">

          Scholarship opportunities for students and professionals.

        </p>

      </div>

      <a href="/scholarships" class="view-all">

        View All Scholarships

        <i class="bi bi-arrow-right"></i>

      </a>

    </div>

    <div class="row g-4">

      {{#if latestScholarships.length}}

        {{#each latestScholarships}}

          <div class="col-md-6 col-lg-4">

            <article class="opportunity-card">

              <div class="d-flex gap-3">

                <div class="card-icon">

                  <i class="bi bi-mortarboard-fill"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/scholarships/{{slug}}" class="card-title">

                    {{title}}

                  </a>

                  <div class="company-name">

                    <i class="bi bi-building"></i>

                    {{providerName}}

                  </div>

                </div>

              </div>

              <div class="card-info">

                {{#if location}}

                  <div>

                    <i class="bi bi-geo-alt"></i>

                    {{location}}

                  </div>

                {{/if}}

                {{#if studyLevel}}

                  <div>

                    <i class="bi bi-mortarboard"></i>

                    {{studyLevel}}

                  </div>

                {{/if}}

              </div>

              <div class="mt-3">

                {{#if fieldOfStudy}}

                  <span class="card-badge purple">

                    {{fieldOfStudy}}

                  </span>

                {{/if}}

                {{#if deadline}}

                  <span class="card-badge green">

                    Deadline:
                    {{deadline}}

                  </span>

                {{/if}}

              </div>

            </article>

          </div>

        {{/each}}

      {{else}}

        <div class="col-12">

          <div class="alert alert-light border">

            No scholarships are currently available.

          </div>

        </div>

      {{/if}}

    </div>

  </section>

  <!-- AD -->

  <!-- =====================================
         LATEST INTERNSHIPS
    ===================================== -->

  <section class="section">

    <div class="d-flex justify-content-between align-items-end mb-3">

      <div>

        <h2 class="section-heading mb-1">

          Latest Internships

        </h2>

        <p class="section-description mb-0">

          Build your experience with internship opportunities.

        </p>

      </div>

      <a href="/internships" class="view-all">

        View All Internships

        <i class="bi bi-arrow-right"></i>

      </a>

    </div>

    <div class="row g-4">

      {{#if latestInternships.length}}

        {{#each latestInternships}}

          <div class="col-md-6 col-lg-4">

            <article class="opportunity-card">

              <div class="d-flex gap-3">

                <div class="card-icon">

                  <i class="bi bi-person-workspace"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/internships/{{slug}}" class="card-title">

                    {{title}}

                  </a>

                  <div class="company-name">

                    <i class="bi bi-building"></i>

                    {{organizationName}}

                  </div>

                </div>

              </div>

              <div class="card-info">

                {{#if location}}

                  <div>

                    <i class="bi bi-geo-alt"></i>

                    {{location}}

                  </div>

                {{/if}}

                {{#if internshipType}}

                  <div>

                    <i class="bi bi-clock"></i>

                    {{internshipType}}

                  </div>

                {{/if}}

                {{#if duration}}

                  <div>

                    <i class="bi bi-calendar3"></i>

                    {{duration}}

                  </div>

                {{/if}}

              </div>

              <div class="mt-3">

                {{#if fieldOfStudy}}

                  <span class="card-badge purple">

                    {{fieldOfStudy}}

                  </span>

                {{/if}}

                {{#if deadline}}

                  <span class="card-badge green">

                    Deadline:
                    {{deadline}}

                  </span>

                {{/if}}

              </div>

            </article>

          </div>

        {{/each}}

      {{else}}

        <div class="col-12">

          <div class="alert alert-light border">

            No internships are currently available.

          </div>

        </div>

      {{/if}}

    </div>

  </section>

  <!-- =====================================
         FEATURED SECTION
    ===================================== -->

  <section class="section">

    <div class="feature-banner">

      <div class="row align-items-center">

        <div class="col-lg-8">

          <h2>

            Don't Miss Your Next Opportunity

          </h2>

          <p class="mb-0 mt-2">

            Explore all available jobs, scholarships and internships and find an
            opportunity that matches your goals.

          </p>

        </div>

        <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">

          <a href="/jobs" class="btn feature-button">

            Explore Opportunities

            <i class="bi bi-arrow-right"></i>

          </a>

        </div>

      </div>

    </div>

  </section>

  <!-- BOTTOM AD -->

  <!-- =====================================
     ABOUT ET24JOBS
===================================== -->

  <section class="section">

    <div class="row justify-content-center">

      <div class="col-lg-9">

        <div class="content-card text-center">

          <h2 class="section-heading mb-3">
            About ET24Jobs
          </h2>

          <p class="section-description mb-3">

            ET24Jobs is an online opportunities platform that helps job seekers,
            students and professionals discover jobs, scholarships and
            internship opportunities in Ethiopia and around the world.

          </p>

          <p class="section-description mb-0">

            We organize opportunities from available sources into an
            easy-to-browse platform, helping visitors find relevant
            opportunities and access the original application information.

          </p>

          <div class="mt-4">

            <a href="/about" class="btn btn-outline-primary">

              Learn More About ET24Jobs

              <i class="bi bi-arrow-right"></i>

            </a>

          </div>

        </div>

      </div>

    </div>

  </section>

</main>