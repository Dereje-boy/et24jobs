<title>Contact Us | ET24Jobs</title>

<meta
  name="description"
  content="Contact ET24Jobs regarding jobs, scholarships, internships, corrections and other inquiries."
/>

<style>
  body {
    background: #f5f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  }

  .navbar {
    background: #fff;
    border-bottom: 1px solid #e5e7eb;
  }

  .navbar-brand {
    font-size: 1.45rem;
    font-weight: 800;
    color: #2563eb !important;
  }

  .navbar-brand span {
    color: #111827;
  }

  .nav-link {
    color: #374151 !important;
    font-weight: 500;
    margin-left: 10px;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #2563eb !important;
  }

  .page-header {
    background: linear-gradient(135deg, #eff6ff, #fff);
    border-bottom: 1px solid #e5e7eb;
    padding: 55px 20px;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
  }

  .page-subtitle {
    color: #6b7280;
    max-width: 650px;
    margin: 15px auto 0;
    line-height: 1.7;
  }

  .content-card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 15px;
    padding: 30px;
    height: 100%;
  }

  .section-title {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 15px;
  }

  .content-text {
    color: #6b7280;
    line-height: 1.8;
  }

  .contact-icon {
    width: 50px;
    height: 50px;
    background: #eff6ff;
    color: #2563eb;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 15px;
  }

  .form-control {
    padding: 12px;
    border-color: #d1d5db;
  }

  .form-control:focus {
    border-color: #2563eb;
    box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.1);
  }

  .ad-box {
    min-height: 90px;
    background: #fff;
    border: 1px dashed #d1d5db;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 0.8rem;
  }

  footer {
    background: #111827;
    color: #9ca3af;
    margin-top: 60px;
    padding: 45px 20px;
  }

  footer h5 {
    color: white;
  }

  footer a {
    color: #9ca3af;
    text-decoration: none;
  }

  footer a:hover {
    color: white;
  }
</style>

<section class="page-header text-center">

  <div class="container">

    <h1 class="page-title">
      Contact Us
    </h1>

    <p class="page-subtitle">

      Have a question, correction or suggestion? We'd like to hear from you.

    </p>

  </div>

</section>

<main class="container my-5">

  <div class="row g-4">

    <div class="col-lg-5">

      <div class="content-card">

        <div class="contact-icon">
          <i class="bi bi-envelope"></i>
        </div>

        <h2 class="section-title">
          Get in Touch
        </h2>

        <p class="content-text">

          You can contact ET24Jobs regarding opportunity information,
          corrections, technical issues, suggestions or other inquiries.

        </p>

        <div class="mt-4">

          <strong>
            Email
          </strong>

          <p class="content-text">
            {{contactEmail}}
          </p>

        </div>

        <div class="mt-4">

          <strong>
            Opportunity Corrections
          </strong>

          <p class="content-text">

            If you notice incorrect, outdated or incomplete information in a
            listing, please contact us with the relevant opportunity title and
            the correction.

          </p>

        </div>

      </div>

    </div>

    <div class="col-lg-7">

      <div class="content-card">

        <h2 class="section-title">
          Send Us a Message
        </h2>

        <p class="content-text">

          Please provide enough information for us to understand your inquiry.

        </p>

        <form action="/contact" method="POST">

          <div class="mb-3">

            <label for="name" class="form-label">
              Name
            </label>

            <input
              type="text"
              id="name"
              name="name"
              class="form-control"
              required
            />

          </div>

          <div class="mb-3">

            <label for="email" class="form-label">
              Email
            </label>

            <input
              type="email"
              id="email"
              name="email"
              class="form-control"
              required
            />

          </div>

          <div class="mb-3">

            <label for="subject" class="form-label">
              Subject
            </label>

            <input
              type="text"
              id="subject"
              name="subject"
              class="form-control"
              required
            />

          </div>

          <div class="mb-4">

            <label for="message" class="form-label">
              Message
            </label>

            <textarea
              id="message"
              name="message"
              rows="6"
              class="form-control"
              required
            ></textarea>

          </div>

          <button type="submit" class="btn btn-primary px-4">

            <i class="bi bi-send"></i>

            Send Message

          </button>

        </form>

      </div>

    </div>

  </div>

</main>