<section class="page-header text-center">

      <div class="container">

        <h1 class="page-title">
          Contact Us
        </h1>

        <p class="page-subtitle">

          Have a question, correction or suggestion? We'd like to hear from you.

        </p>

      </div>

    </section>

    <main class="container my-5">

      <div class="ad-box mb-5">
        Advertisement
      </div>

      <div class="row g-4">

        <div class="col-lg-5">

          <div class="content-card">

            <div class="contact-icon">
              <i class="bi bi-envelope"></i>
            </div>

            <h2 class="section-title">
              Get in Touch
            </h2>

            <p class="content-text">

              You can contact ET24Jobs regarding opportunity information,
              corrections, technical issues, suggestions or other inquiries.

            </p>

            <div class="mt-4">

              <strong>
                Email
              </strong>

              <p class="content-text">
                {{contactEmail}}
              </p>

            </div>

            <div class="mt-4">

              <strong>
                Opportunity Corrections
              </strong>

              <p class="content-text">

                If you notice incorrect, outdated or incomplete information in a
                listing, please contact us with the relevant opportunity title
                and the correction.

              </p>

            </div>

          </div>

        </div>

        <div class="col-lg-7">

          <div class="content-card">

            <h2 class="section-title">
              Send Us a Message
            </h2>

            <p class="content-text">

              Please provide enough information for us to understand your
              inquiry.

            </p>

            <form action="/contact" method="POST">

              <div class="mb-3">

                <label for="name" class="form-label">
                  Name
                </label>

                <input
                  type="text"
                  id="name"
                  name="name"
                  class="form-control"
                  required
                />

              </div>

              <div class="mb-3">

                <label for="email" class="form-label">
                  Email
                </label>

                <input
                  type="email"
                  id="email"
                  name="email"
                  class="form-control"
                  required
                />

              </div>

              <div class="mb-3">

                <label for="subject" class="form-label">
                  Subject
                </label>

                <input
                  type="text"
                  id="subject"
                  name="subject"
                  class="form-control"
                  required
                />

              </div>

              <div class="mb-4">

                <label for="message" class="form-label">
                  Message
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  class="form-control"
                  required
                ></textarea>

              </div>

              <button type="submit" class="btn btn-primary px-4">

                <i class="bi bi-send"></i>

                Send Message

              </button>

            </form>

          </div>

        </div>

      </div>

    </main>
