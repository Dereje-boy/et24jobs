<html lang="en">

  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Scholarships | ET24Jobs</title>

    <meta
      name="description"
      content="Find scholarships and fully funded study opportunities on ET24Jobs."
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      body {
        background: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      /* =========================
           NAVBAR
        ========================= */

      .navbar {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
      }

      .navbar-brand {
        font-size: 1.45rem;
        font-weight: 800;
        color: #2563eb !important;
      }

      .navbar-brand span {
        color: #111827;
      }

      .nav-link {
        color: #374151 !important;
        font-weight: 500;
        margin-left: 10px;
      }

      .nav-link:hover,
      .nav-link.active {
        color: #2563eb !important;
      }

      /* =========================
           HERO
        ========================= */

      .scholarship-hero {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);

        color: white;

        padding: 55px 20px;

        border-radius: 0 0 25px 25px;
      }

      .scholarship-hero h1 {
        font-size: 2.4rem;
        font-weight: 800;
      }

      .scholarship-hero p {
        max-width: 650px;
        margin: 15px auto 0;
        opacity: 0.92;
        font-size: 1.05rem;
      }

      /* =========================
           SEARCH
        ========================= */

      .search-box {
        margin-top: -25px;
        position: relative;
        z-index: 5;
      }

      .search-card {
        background: white;
        border-radius: 15px;
        padding: 18px;

        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }

      .search-input {
        border: 1px solid #d1d5db;
        border-radius: 10px;
        height: 48px;
      }

      .search-button {
        height: 48px;
        border-radius: 10px;
        font-weight: 600;
      }

      /* =========================
           SECTION
        ========================= */

      .section-title {
        font-weight: 800;
        color: #111827;
      }

      .result-count {
        color: #6b7280;
      }

      /* =========================
           SCHOLARSHIP CARD
        ========================= */

      .scholarship-card {
        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 15px;

        padding: 22px;

        height: 100%;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .scholarship-card:hover {
        transform: translateY(-4px);

        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      }

      .scholarship-icon {
        width: 50px;
        height: 50px;

        border-radius: 12px;

        background: #eff6ff;

        color: #2563eb;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 1.35rem;

        flex-shrink: 0;
      }

      .scholarship-title {
        font-size: 1.15rem;
        font-weight: 700;

        color: #111827;

        text-decoration: none;
      }

      .scholarship-title:hover {
        color: #2563eb;
      }

      .provider {
        color: #6b7280;
        font-size: 0.9rem;
      }

      .info-item {
        color: #4b5563;
        font-size: 0.88rem;
        margin-bottom: 7px;
      }

      .info-item i {
        width: 20px;
        color: #2563eb;
      }

      /* =========================
           BADGES
        ========================= */

      .funded-badge {
        background: #dcfce7;
        color: #166534;

        font-size: 0.78rem;

        font-weight: 600;

        padding: 5px 9px;

        border-radius: 20px;
      }

      .partial-badge {
        background: #fef3c7;
        color: #92400e;

        font-size: 0.78rem;

        font-weight: 600;

        padding: 5px 9px;

        border-radius: 20px;
      }

      .deadline {
        border-top: 1px solid #e5e7eb;

        margin-top: 18px;
        padding-top: 15px;

        color: #6b7280;

        font-size: 0.88rem;
      }

      .deadline strong {
        color: #dc2626;
      }

      /* =========================
           BUTTON
        ========================= */

      .details-button {
        border-radius: 9px;

        font-weight: 600;

        padding: 9px 16px;
      }

      /* =========================
           ADVERTISEMENT
        ========================= */

      .ad-box {
        min-height: 90px;

        background: #ffffff;

        border: 1px dashed #d1d5db;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #9ca3af;

        font-size: 0.8rem;
      }

      /* =========================
           FOOTER
        ========================= */

      footer {
        background: #111827;

        color: #9ca3af;

        margin-top: 60px;

        padding: 40px 20px;
      }

      footer h5 {
        color: white;
        font-weight: 700;
      }

      footer a {
        color: #9ca3af;
        text-decoration: none;
      }

      footer a:hover {
        color: white;
      }

      /* =========================
           MOBILE
        ========================= */

      @media (max-width: 768px) {
        .scholarship-hero {
          padding: 40px 20px;
        }

        .scholarship-hero h1 {
          font-size: 1.9rem;
        }

        .search-box {
          margin-top: -15px;
        }
      }
    </style>

  </head>

  <body>

    <!-- =========================
     NAVBAR
========================= -->

    <nav class="navbar navbar-expand-lg">

      <div class="container">

        <a class="navbar-brand" href="/">
          ET24<span>Jobs</span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
        >

          <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

          <ul class="navbar-nav ms-auto">

            <li class="nav-item">
              <a class="nav-link" href="/">
                Home
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/jobs">
                Jobs
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link active" href="/scholarships">
                Scholarships
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/internships">
                Internships
              </a>
            </li>

            <li class="nav-item">
              <a class="nav-link" href="/scholarships/post">
                Post a Scholarship
              </a>
            </li>

          </ul>

        </div>

      </div>

    </nav>

    <!-- =========================
     HERO
========================= -->

    <section class="scholarship-hero text-center">

      <div class="container">

        <h1>
          Find Your Scholarship
        </h1>

        <p>
          Discover scholarships, fellowships and fully funded opportunities from
          around the world.
        </p>

      </div>

    </section>

    <!-- =========================
     SEARCH
========================= -->

    <div class="container search-box">

      <div class="search-card">

        <form>

          <div class="row g-2">

            <div class="col-md-9">

              <input
                type="search"
                class="form-control search-input"
                placeholder="Search scholarships, universities, fields..."
              />

            </div>

            <div class="col-md-3">

              <button type="submit" class="btn btn-primary w-100 search-button">

                <i class="bi bi-search"></i>

                Search Scholarships

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

    <!-- =========================
     MAIN CONTENT
========================= -->

    <main class="container my-5">

      <!-- Advertisement -->

      <!-- Heading -->

      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

          <h2 class="section-title mb-1">
            Latest Scholarships
          </h2>

          <div class="result-count">
            Showing
            {{scholarships.length}}
            opportunities
          </div>

        </div>

      </div>

      <!-- Scholarship Cards -->

      <div class="row g-4">

        {{#each scholarships}}

          <div class="col-lg-6">

            <article class="scholarship-card">

              <!-- Header -->

              <div class="d-flex gap-3 mb-3">

                <div class="scholarship-icon">

                  <i class="bi bi-mortarboard-fill"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/scholarships/{{slug}}" class="scholarship-title">

                    {{title}}

                  </a>

                  <div class="provider mt-1">

                    <i class="bi bi-building"></i>

                    {{providerName}}

                  </div>

                </div>

              </div>

              <!-- Funding -->

              <div class="mb-3">

                {{#if (eq fundingType "fully-funded")}}

                  <span class="funded-badge">

                    <i class="bi bi-check-circle"></i>

                    Fully Funded

                  </span>

                {{else}}

                  <span class="partial-badge">

                    {{fundingType}}

                  </span>

                {{/if}}

              </div>

              <!-- Information -->

              <div>

                {{#if studyLevel}}

                  <div class="info-item">

                    <i class="bi bi-mortarboard"></i>

                    {{studyLevel}}

                  </div>

                {{/if}}

                {{#if fieldOfStudy}}

                  <div class="info-item">

                    <i class="bi bi-book"></i>

                    {{fieldOfStudy}}

                  </div>

                {{/if}}

                {{#if hostCountry}}

                  <div class="info-item">

                    <i class="bi bi-geo-alt"></i>

                    {{hostCountry}}

                  </div>

                {{/if}}

                {{#if studyMode}}

                  <div class="info-item">

                    <i class="bi bi-laptop"></i>

                    {{studyMode}}

                  </div>

                {{/if}}

              </div>

              <!-- Description -->

              <p class="text-muted mt-3 mb-0">

                {{description}}

              </p>

              <!-- Deadline -->

              <div class="deadline">

                <i class="bi bi-calendar-event"></i>

                Application deadline:

                <strong>
                  {{deadline}}
                </strong>

              </div>

              <!-- Button -->

              <div class="mt-3">

                <a
                  href="/scholarships/{{slug}}"
                  class="btn btn-primary details-button"
                >

                  View Scholarship

                  <i class="bi bi-arrow-right"></i>

                </a>

              </div>

            </article>

          </div>

        {{/each}}

      </div>

      <!-- Bottom Advertisement -->

    </main>

    <!-- =========================
     FOOTER
========================= -->

    <footer>

      <div class="container">

        <div class="row g-4">

          <div class="col-md-5">

            <h5>
              ET24Jobs
            </h5>

            <p class="mt-3">
              Find jobs, scholarships and internships in Ethiopia and around the
              world.
            </p>

          </div>

          <div class="col-md-3">

            <h5>
              Explore
            </h5>

            <ul class="list-unstyled mt-3">

              <li class="mb-2">
                <a href="/jobs">
                  Jobs
                </a>
              </li>

              <li class="mb-2">
                <a href="/scholarships">
                  Scholarships
                </a>
              </li>

              <li>
                <a href="/internships">
                  Internships
                </a>
              </li>

            </ul>

          </div>

          <div class="col-md-4">

            <h5>
              ET24Jobs
            </h5>

            <p class="mt-3">
              Helping students and job seekers discover new opportunities.
            </p>

          </div>

        </div>

        <hr class="border-secondary my-4" />

        <div class="text-center">

          <small>
            © 2026 ET24Jobs. All rights reserved.
          </small>

        </div>

      </div>

    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>

</html>