<title>{{scholarship.title}} | ET24Jobs</title>

<meta
  name="description"
  content="{{scholarship.title}} scholarship — eligibility, funding, deadline and application information on ET24Jobs."
/>

<style>
  /* =========================
           GLOBAL
        ========================= */

  body {
    background: #f5f7fb;

    font-family: Arial, Helvetica, sans-serif;

    color: #1f2937;
  }

  /* =========================
           NAVBAR
        ========================= */

  .navbar {
    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;
  }

  .navbar-brand {
    font-size: 1.45rem;

    font-weight: 800;

    color: #2563eb !important;
  }

  .navbar-brand span {
    color: #111827;
  }

  .nav-link {
    color: #374151 !important;

    font-weight: 500;

    margin-left: 10px;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #2563eb !important;
  }

  /* =========================
           BREADCRUMB
           ========================= */

  .breadcrumb-wrapper {
    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;
  }

  .breadcrumb {
    margin-bottom: 0;

    padding: 14px 0;
  }

  .breadcrumb a {
    color: #2563eb;

    text-decoration: none;
  }

  /* =========================
           AD
           ========================= */

  .ad-box {
    min-height: 90px;

    background: #ffffff;

    border: 1px dashed #d1d5db;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #9ca3af;

    font-size: 0.8rem;
  }

  /* =========================
           SCHOLARSHIP HEADER
           ========================= */

  .scholarship-header {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 28px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
  }

  .scholarship-icon {
    width: 65px;

    height: 65px;

    border-radius: 14px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 1.7rem;

    flex-shrink: 0;
  }

  .scholarship-title {
    font-size: 2rem;

    font-weight: 800;

    color: #111827;

    line-height: 1.25;
  }

  .provider-name {
    color: #6b7280;

    font-size: 1rem;
  }

  /* =========================
           BADGES
           ========================= */

  .scholarship-badge {
    display: inline-block;

    font-size: 0.8rem;

    font-weight: 600;

    padding: 6px 10px;

    border-radius: 20px;

    background: #eff6ff;

    color: #1d4ed8;

    margin-right: 5px;

    margin-bottom: 5px;
  }

  .scholarship-badge.location {
    background: #f3f4f6;

    color: #4b5563;
  }

  .scholarship-badge.field {
    background: #f3e8ff;

    color: #7e22ce;
  }

  /* =========================
           CONTENT CARDS
           ========================= */

  .content-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 25px;

    margin-bottom: 22px;
  }

  .section-title {
    font-size: 1.25rem;

    font-weight: 800;

    color: #111827;

    margin-bottom: 18px;
  }

  .scholarship-description {
    color: #4b5563;

    line-height: 1.75;

    white-space: pre-line;
  }

  /* =========================
           INFORMATION ROWS
           ========================= */

  .info-row {
    display: flex;

    padding: 13px 0;

    border-bottom: 1px solid #f0f0f0;
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    width: 190px;

    font-weight: 600;

    color: #374151;
  }

  .info-value {
    color: #6b7280;

    flex: 1;
  }

  /* =========================
           LISTS
           ========================= */

  .detail-list {
    padding-left: 20px;

    color: #4b5563;

    line-height: 1.8;
  }

  /* =========================
           APPLICATION CARD
           ========================= */

  .apply-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 24px;

    position: sticky;

    top: 20px;
  }

  .apply-title {
    font-size: 1.2rem;

    font-weight: 800;

    color: #111827;
  }

  .deadline-box {
    background: #fff7ed;

    border: 1px solid #fed7aa;

    color: #9a3412;

    border-radius: 10px;

    padding: 13px;

    font-size: 0.9rem;

    margin: 18px 0;
  }

  .funding-box {
    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    color: #166534;

    border-radius: 10px;

    padding: 13px;

    font-size: 0.9rem;

    margin-bottom: 15px;
  }

  .apply-button {
    width: 100%;

    border-radius: 10px;

    padding: 12px;

    font-weight: 700;

    font-size: 1rem;
  }

  .source-note {
    font-size: 0.78rem;

    color: #9ca3af;

    line-height: 1.5;

    margin-top: 15px;
  }

  /* =========================
           SHARE
           ========================= */

  .share-button {
    border: 1px solid #d1d5db;

    background: #ffffff;

    color: #374151;

    border-radius: 8px;

    padding: 7px 12px;

    font-size: 0.85rem;
  }

  .share-button:hover {
    background: #f3f4f6;
  }

  /* =========================
           RELATED SCHOLARSHIPS
           ========================= */

  .related-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 14px;

    padding: 18px;

    height: 100%;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
  }

  .related-icon {
    width: 42px;

    height: 42px;

    border-radius: 10px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;
  }

  .related-title {
    color: #111827;

    font-weight: 700;

    text-decoration: none;

    line-height: 1.35;
  }

  .related-title:hover {
    color: #2563eb;
  }

  .related-provider {
    color: #6b7280;

    font-size: 0.85rem;
  }

  .related-info {
    color: #6b7280;

    font-size: 0.82rem;

    margin-top: 10px;
  }

  /* =========================
           FOOTER
           ========================= */

  footer {
    background: #111827;

    color: #9ca3af;

    margin-top: 60px;

    padding: 40px 20px;
  }

  footer h5 {
    color: white;

    font-weight: 700;
  }

  footer a {
    color: #9ca3af;

    text-decoration: none;
  }

  footer a:hover {
    color: white;
  }

  /* =========================
           MOBILE
           ========================= */

  @media (max-width: 768px) {
    .scholarship-title {
      font-size: 1.55rem;
    }

    .scholarship-header {
      padding: 20px;
    }

    .content-card {
      padding: 20px;
    }

    .info-row {
      display: block;
    }

    .info-label {
      width: auto;

      margin-bottom: 4px;
    }

    .apply-card {
      position: static;
    }
  }
</style>

<!-- =========================
     BREADCRUMB
========================= -->

<div class="breadcrumb-wrapper">

  <div class="container">

    <nav aria-label="breadcrumb">

      <ol class="breadcrumb">

        <li class="breadcrumb-item">

          <a href="/">

            Home

          </a>

        </li>

        <li class="breadcrumb-item">

          <a href="/scholarships">

            Scholarships

          </a>

        </li>

        <li class="breadcrumb-item active" aria-current="page">

          {{scholarship.title}}

        </li>

      </ol>

    </nav>

  </div>

</div>

<!-- =========================
     MAIN
========================= -->

<main class="container my-4">

  <!-- TOP AD -->

  <!-- =========================
         SCHOLARSHIP HEADER
    ========================= -->

  <section class="scholarship-header mb-4">

    <div class="d-flex gap-3">

      <div class="scholarship-icon">

        <i class="bi bi-mortarboard-fill"></i>

      </div>

      <div class="flex-grow-1">

        <h1 class="scholarship-title mb-2">

          {{scholarship.title}}

        </h1>

        <div class="provider-name mb-3">

          <i class="bi bi-building"></i>

          {{scholarship.providerName}}

        </div>

        <div>

          {{#if scholarship.studyLevel}}

            <span class="scholarship-badge">

              <i class="bi bi-mortarboard"></i>

              {{scholarship.studyLevel}}

            </span>

          {{/if}}

          {{#if scholarship.location}}

            <span class="scholarship-badge location">

              <i class="bi bi-geo-alt"></i>

              {{scholarship.location}}

            </span>

          {{/if}}

          {{#if scholarship.fieldOfStudy}}

            <span class="scholarship-badge field">

              {{scholarship.fieldOfStudy}}

            </span>

          {{/if}}

        </div>

      </div>

    </div>

    <!-- SHARE -->

    <div class="mt-4 pt-3 border-top">

      <button class="share-button" onclick="shareScholarship()">

        <i class="bi bi-share"></i>

        Share Scholarship

      </button>

    </div>

  </section>

  <!-- =========================
         CONTENT + SIDEBAR
    ========================= -->

  <div class="row g-4">

    <!-- =====================
             LEFT COLUMN
        ====================== -->

    <div class="col-lg-8">

      <!-- Overview -->

      <section class="content-card">

        <h2 class="section-title">

          Scholarship Overview

        </h2>

        <div class="scholarship-description">

          {{scholarship.description}}

        </div>

      </section>

      <!-- Scholarship Details -->

      <section class="content-card">

        <h2 class="section-title">

          Scholarship Details

        </h2>

        {{#if scholarship.providerName}}

          <div class="info-row">

            <div class="info-label">

              Scholarship Provider

            </div>

            <div class="info-value">

              {{scholarship.providerName}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.studyLevel}}

          <div class="info-row">

            <div class="info-label">

              Study Level

            </div>

            <div class="info-value">

              {{scholarship.studyLevel}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.fieldOfStudy}}

          <div class="info-row">

            <div class="info-label">

              Field of Study

            </div>

            <div class="info-value">

              {{scholarship.fieldOfStudy}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.location}}

          <div class="info-row">

            <div class="info-label">

              Study Location

            </div>

            <div class="info-value">

              {{scholarship.location}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.degreeType}}

          <div class="info-row">

            <div class="info-label">

              Degree / Program

            </div>

            <div class="info-value">

              {{scholarship.degreeType}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.duration}}

          <div class="info-row">

            <div class="info-label">

              Duration

            </div>

            <div class="info-value">

              {{scholarship.duration}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.numberOfAwards}}

          <div class="info-row">

            <div class="info-label">

              Number of Awards

            </div>

            <div class="info-value">

              {{scholarship.numberOfAwards}}

            </div>

          </div>

        {{/if}}

        {{#if scholarship.applicationType}}

          <div class="info-row">

            <div class="info-label">

              Application Type

            </div>

            <div class="info-value">

              {{scholarship.applicationType}}

            </div>

          </div>

        {{/if}}

      </section>

      <!-- Funding -->

      {{#if scholarship.fundingDetails}}

        <section class="content-card">

          <h2 class="section-title">

            Funding & Benefits

          </h2>

          <div class="scholarship-description">

            {{scholarship.fundingDetails}}

          </div>

        </section>

      {{/if}}

      <!-- Eligibility -->

      {{#if scholarship.eligibility}}

        <section class="content-card">

          <h2 class="section-title">

            Eligibility Requirements

          </h2>

          <div class="scholarship-description">

            {{scholarship.eligibility}}

          </div>

        </section>

      {{/if}}

      <!-- Required Documents -->

      {{#if scholarship.requiredDocuments}}

        <section class="content-card">

          <h2 class="section-title">

            Required Documents

          </h2>

          <div class="scholarship-description">

            {{scholarship.requiredDocuments}}

          </div>

        </section>

      {{/if}}

      <!-- How To Apply -->

      {{#if scholarship.applicationInstructions}}

        <section class="content-card">

          <h2 class="section-title">

            How to Apply

          </h2>

          <div class="scholarship-description">

            {{scholarship.applicationInstructions}}

          </div>

        </section>

      {{/if}}

      <!-- Source -->

      <section class="content-card">

        <h2 class="section-title">

          Scholarship Source

        </h2>

        <p class="text-muted mb-2">

          This scholarship information is published on ET24Jobs based on
          information from the original scholarship provider or source.

        </p>

        {{#if scholarship.sourceName}}

          <div class="info-item mb-2">

            <i class="bi bi-link-45deg"></i>

            Source:

            <strong>

              {{scholarship.sourceName}}

            </strong>

          </div>

        {{/if}}

        {{#if scholarship.sourceUrl}}

          <a
            href="{{scholarship.sourceUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-primary mt-2"
          >

            <i class="bi bi-box-arrow-up-right"></i>

            Visit Original Source

          </a>

        {{/if}}

      </section>

    </div>

    <!-- =====================
             RIGHT SIDEBAR
        ====================== -->

    <div class="col-lg-4">

      <aside class="apply-card">

        <div class="apply-title">

          Apply for this Scholarship

        </div>

        <!-- Funding -->

        {{#if scholarship.fundingType}}

          <div class="funding-box mt-3">

            <i class="bi bi-cash-stack"></i>

            <strong>

              Funding

            </strong>

            <br />

            {{scholarship.fundingType}}

          </div>

        {{/if}}

        <!-- Deadline -->

        {{#if scholarship.deadline}}

          <div class="deadline-box">

            <i class="bi bi-calendar-event"></i>

            <strong>

              Application Deadline

            </strong>

            <br />

            {{scholarship.deadline}}

          </div>

        {{/if}}

        <!-- Apply -->

        {{#if scholarship.applicationUrl}}

          <a
            href="{{scholarship.applicationUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary apply-button"
          >

            Apply Now

            <i class="bi bi-arrow-right"></i>

          </a>

        {{else}}

          <div class="alert alert-warning">

            Application link is not currently available.

          </div>

        {{/if}}

        <div class="source-note">

          Applicants should verify eligibility, deadlines and application
          requirements with the official scholarship provider before applying.

        </div>

      </aside>

      <!-- SIDEBAR AD -->
    </div>

  </div>

  <!-- =========================
         MIDDLE AD
    ========================= -->

  <!-- =========================
         RELATED SCHOLARSHIPS
    ========================= -->

  <section>

    <div class="d-flex justify-content-between align-items-center mb-4">

      <h2 class="section-title mb-0">

        Related Scholarships

      </h2>

      <a href="/scholarships" class="btn btn-outline-primary btn-sm">

        View All Scholarships

      </a>

    </div>

    <div class="row g-4">

      {{#each relatedScholarships}}

        <div class="col-md-6 col-lg-4">

          <article class="related-card">

            <div class="d-flex gap-3">

              <div class="related-icon">

                <i class="bi bi-mortarboard-fill"></i>

              </div>

              <div>

                <a href="/scholarships/{{slug}}" class="related-title">

                  {{title}}

                </a>

                <div class="related-provider mt-1">

                  <i class="bi bi-building"></i>

                  {{providerName}}

                </div>

              </div>

            </div>

            <div class="related-info">

              {{#if fieldOfStudy}}

                <div class="mb-1">

                  <i class="bi bi-book"></i>

                  {{fieldOfStudy}}

                </div>

              {{/if}}

              {{#if studyLevel}}

                <div class="mb-1">

                  <i class="bi bi-mortarboard"></i>

                  {{studyLevel}}

                </div>

              {{/if}}

              {{#if deadline}}

                <div>

                  <i class="bi bi-calendar-event"></i>

                  Deadline:

                  {{deadline}}

                </div>

              {{/if}}

            </div>

            <div class="mt-3">

              <a
                href="/scholarships/{{slug}}"
                class="btn btn-sm btn-outline-primary"
              >

                View Scholarship

                <i class="bi bi-arrow-right"></i>

              </a>

            </div>

          </article>

        </div>

      {{/each}}

    </div>

  </section>

  <!-- =========================
         BOTTOM AD
    ========================= -->
</main>

<!-- =========================
     SHARE SCRIPT
========================= -->

<script>

  function shareScholarship() { if (navigator.share) { navigator.share({ title:
  "{{scholarship.title}}
  | ET24Jobs", text: "Check out this scholarship opportunity on ET24Jobs.", url:
  window.location.href }); } else { navigator.clipboard.writeText(
  window.location.href ); alert( "Scholarship link copied to clipboard." ); } }

</script>