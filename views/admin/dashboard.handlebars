<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Dashboard | ET24Jobs</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      body {
        background: #f5f7fb;
        color: #1f2937;
        font-family: Arial, Helvetica, sans-serif;
      }

      .admin-navbar {
        background: #111827;
        color: #e5e7eb;
        padding: 12px 0;
      }

      .admin-navbar .brand {
        color: #ffffff;
        font-weight: 800;
        text-decoration: none;
      }

      .admin-navbar .brand span {
        color: #60a5fa;
      }

      .admin-navbar a.nav-item-link {
        color: #d1d5db;
        text-decoration: none;
        margin-right: 16px;
      }

      .admin-navbar a.nav-item-link:hover,
      .admin-navbar a.nav-item-link.active {
        color: #60a5fa;
      }

      .stat-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        text-decoration: none;
        transition:
          transform 0.15s ease,
          box-shadow 0.15s ease;
      }

      .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
      }

      .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: #eff6ff;
        color: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
      }

      .stat-value {
        font-size: 1.6rem;
        font-weight: 800;
        color: #111827;
        line-height: 1;
      }

      .stat-label {
        color: #6b7280;
        font-size: 0.85rem;
        margin-top: 4px;
      }

      .panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 20px;
      }

      .panel-title {
        font-weight: 800;
        color: #111827;
        font-size: 1.05rem;
      }

      .table > :not(caption) > * > * {
        padding: 10px 12px;
      }

      .badge-draft {
        background: #f3f4f6;
        color: #4b5563;
      }
      .badge-published {
        background: #dcfce7;
        color: #166534;
      }
      .badge-expired {
        background: #fef2f2;
        color: #b91c1c;
      }
      .badge-archived {
        background: #e0e7ff;
        color: #3730a3;
      }
    </style>

  </head>

  <body>

    <!-- Admin navbar -->

    <nav class="admin-navbar">

      <div class="container d-flex flex-wrap align-items-center gap-3">

        <a class="brand me-auto" href="/admin">
          ET24<span>Jobs</span>
          Admin
        </a>

        <a class="nav-item-link active" href="/admin">
          Dashboard
        </a>

        <a class="nav-item-link" href="/admin/jobs">
          Jobs
        </a>

        <a class="nav-item-link" href="/admin/scholarships">
          Scholarships
        </a>

        <a class="nav-item-link" href="/admin/internships">
          Internships
        </a>

        <span class="small text-muted d-none d-md-inline">
          <i class="bi bi-person-circle"></i>
          {{adminUsername}}
        </span>

        <form action="/admin/logout" method="POST" class="m-0">

          <button type="submit" class="btn btn-outline-light btn-sm">
            <i class="bi bi-box-arrow-right"></i>
            Logout
          </button>

        </form>

      </div>

    </nav>

    <main class="container my-4">

      <h1 class="h4 fw-bold mb-4">
        Dashboard
      </h1>

      <!-- Stat cards -->

      <div class="row g-3 mb-4">

        <div class="col-md-4">

          <div class="d-flex align-items-center gap-2">

            <a
              class="stat-card flex-grow-1 text-decoration-none"
              href="/admin/jobs"
            >
              <div class="stat-icon">
                <i class="bi bi-briefcase-fill"></i>
              </div>
              <div>
                <div class="stat-value">
                  {{counts.jobs}}
                </div>
                <div class="stat-label">
                  Jobs
                </div>
              </div>
            </a>

            <div class="flex-shrink-0">
              <a
                href="/jobs/post"
                class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                style="width: 32px; height: 32px;"
                title="New Job"
              >
                <i class="bi bi-plus-lg"></i>
              </a>
            </div>

          </div>

        </div>

        <div class="col-md-4">

          <div class="d-flex align-items-center gap-2">

            <a
              class="stat-card flex-grow-1 text-decoration-none"
              href="/admin/scholarships"
            >
              <div class="stat-icon">
                <i class="bi bi-mortarboard-fill"></i>
              </div>
              <div>
                <div class="stat-value">
                  {{counts.scholarships}}
                </div>
                <div class="stat-label">
                  Scholarships
                </div>
              </div>
            </a>

            <div class="flex-shrink-0">
              <a
                href="/scholarships/post"
                class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                style="width: 32px; height: 32px;"
                title="New Scholarship"
              >
                <i class="bi bi-plus-lg"></i>
              </a>
            </div>

          </div>

        </div>

        <div class="col-md-4">

          <div class="d-flex align-items-center gap-2">

            <a
              class="stat-card flex-grow-1 text-decoration-none"
              href="/admin/internships"
            >
              <div class="stat-icon">
                <i class="bi bi-lightbulb-fill"></i>
              </div>
              <div>
                <div class="stat-value">
                  {{counts.internships}}
                </div>
                <div class="stat-label">
                  Internships
                </div>
              </div>
            </a>

            <div class="flex-shrink-0">
              <a
                href="/internships/post"
                class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                style="width: 32px; height: 32px;"
                title="New Internship"
              >
                <i class="bi bi-plus-lg"></i>
              </a>
            </div>

          </div>

        </div>

      </div>

      <!-- Recent items -->

      <div class="row g-3">

        <div class="col-lg-4">

          <div class="panel h-100">

            <div class="d-flex justify-content-between align-items-center mb-2">

              <h2 class="panel-title mb-0">
                Recent Jobs
              </h2>

              <a href="/admin/jobs" class="small text-decoration-none">
                View all
              </a>

            </div>

            {{#each recentJobs}}

              <div
                class="d-flex justify-content-between align-items-center border-bottom py-2"
              >

                <div class="me-2 text-truncate">

                  <a
                    href="/jobs/{{this.slug}}"
                    class="small fw-semibold text-decoration-none d-block text-truncate"
                  >
                    {{this.title}}
                  </a>

                  <small class="text-muted">{{this.companyName}}</small>

                </div>

                <span class="badge badge-{{this.status}}">{{this.status}}</span>

              </div>

            {{else}}

              <p class="text-muted small mb-0">
                No jobs yet.
              </p>

            {{/each}}

          </div>

        </div>

        <div class="col-lg-4">

          <div class="panel h-100">

            <div class="d-flex justify-content-between align-items-center mb-2">

              <h2 class="panel-title mb-0">
                Recent Scholarships
              </h2>

              <a href="/admin/scholarships" class="small text-decoration-none">
                View all
              </a>

            </div>

            {{#each recentScholarships}}

              <div
                class="d-flex justify-content-between align-items-center border-bottom py-2"
              >

                <div class="me-2 text-truncate">

                  <span class="small fw-semibold d-block text-truncate">
                    {{this.title}}
                  </span>

                  <small class="text-muted">{{this.providerName}}</small>

                </div>

                <span class="badge badge-{{this.status}}">{{this.status}}</span>

              </div>

            {{else}}

              <p class="text-muted small mb-0">
                No scholarships yet.
              </p>

            {{/each}}

          </div>

        </div>

        <div class="col-lg-4">

          <div class="panel h-100">

            <div class="d-flex justify-content-between align-items-center mb-2">

              <h2 class="panel-title mb-0">
                Recent Internships
              </h2>

              <a href="/admin/internships" class="small text-decoration-none">
                View all
              </a>

            </div>

            {{#each recentInternships}}

              <div
                class="d-flex justify-content-between align-items-center border-bottom py-2"
              >

                <div class="me-2 text-truncate">

                  <span class="small fw-semibold d-block text-truncate">
                    {{this.title}}
                  </span>

                  <small class="text-muted">{{this.organizationName}}</small>

                </div>

                <span class="badge badge-{{this.status}}">{{this.status}}</span>

              </div>

            {{else}}

              <p class="text-muted small mb-0">
                No internships yet.
              </p>

            {{/each}}

          </div>

        </div>

      </div>

    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script>
      // Let the + button navigate to its own href (the create page), // not the
      parent card's href (the admin list).
      document.querySelectorAll('.plus-btn[data-plus]').forEach((btn) => {
      btn.addEventListener('click', (e) => { const createUrl =
      btn.getAttribute('href'); if (createUrl) { e.preventDefault();
      window.location.href = createUrl; } }); });
    </script>

  </body>

</html>