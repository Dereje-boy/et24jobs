<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Manage {{entityTitle}} | ET24Jobs Admin</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      body {
        background: #f5f7fb;
        color: #1f2937;
        font-family: Arial, Helvetica, sans-serif;
      }

      .admin-navbar {
        background: #111827;
        color: #e5e7eb;
        padding: 12px 0;
      }

      .admin-navbar .brand {
        color: #ffffff;
        font-weight: 800;
        text-decoration: none;
      }

      .admin-navbar .brand span {
        color: #60a5fa;
      }

      .admin-navbar a.nav-item-link {
        color: #d1d5db;
        text-decoration: none;
        margin-right: 16px;
      }

      .admin-navbar a.nav-item-link:hover,
      .admin-navbar a.nav-item-link.active {
        color: #60a5fa;
      }

      .panel {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 20px;
      }

      .item-title {
        font-weight: 700;
        color: #111827;
        text-decoration: none;
      }

      .item-title:hover {
        color: #2563eb;
      }

      .table > :not(caption) > * > * {
        padding: 12px;
      }

      .badge-draft { background: #f3f4f6; color: #4b5563; }
      .badge-published { background: #dcfce7; color: #166534; }
      .badge-expired { background: #fef2f2; color: #b91c1c; }
      .badge-archived { background: #e0e7ff; color: #3730a3; }

      .status-form select {
        max-width: 130px;
      }
    </style>

  </head>

  <body>

    <!-- Admin navbar -->

    <nav class="admin-navbar">

      <div class="container d-flex flex-wrap align-items-center gap-3">

        <a class="brand me-auto" href="/admin">
          ET24<span>Jobs</span> Admin
        </a>

        <a class="nav-item-link {{#ifEquals entity "jobs"}}active{{/ifEquals}}" href="/admin/jobs">
          Jobs
        </a>

        <a class="nav-item-link {{#ifEquals entity "scholarships"}}active{{/ifEquals}}" href="/admin/scholarships">
          Scholarships
        </a>

        <a class="nav-item-link {{#ifEquals entity "internships"}}active{{/ifEquals}}" href="/admin/internships">
          Internships
        </a>

        <span class="small text-muted d-none d-md-inline">
          <i class="bi bi-person-circle"></i>
          {{adminUsername}}
        </span>

        <form action="/admin/logout" method="POST" class="m-0">

          <button type="submit" class="btn btn-outline-light btn-sm">
            <i class="bi bi-box-arrow-right"></i>
            Logout
          </button>

        </form>

      </div>

    </nav>

    <main class="container my-4">

      <!-- One-time result of the previous action (archive, restore,
           status switch, delete, or an error) - shown once, then cleared. -->

      {{#if flash}}

        <div class="alert alert-{{flash.type}} alert-dismissible fade show" role="alert">

          {{flash.text}}

          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>

        </div>

      {{/if}}

      <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">

        <h1 class="h4 fw-bold mb-0">
          Manage {{entityTitle}}
          <span class="text-muted fs-6 fw-normal">
            ({{items.length}})
          </span>
        </h1>

        {{#if newUrl}}

          <a class="btn btn-primary btn-sm" href="{{newUrl}}">
            <i class="bi bi-plus-lg"></i>
            New {{entityTitle}}
          </a>

        {{/if}}

      </div>

      <div class="panel">

        <div class="table-responsive">

          <table class="table align-middle mb-0">

            <thead>

              <tr>

                <th>
                  Title
                </th>

                <th>
                  Status
                </th>

                <th>
                  Deadline
                </th>

                <th>
                  Views
                </th>

                <th>
                  Created
                </th>

                <th class="text-end">
                  Actions
                </th>

              </tr>

            </thead>

            <tbody>

              {{#each items}}

                <tr>

                  <td>

                    <a href="{{this.detailUrl}}" class="item-title d-block text-truncate" style="max-width: 320px;">
                      {{this.title}}
                    </a>

                    <small class="text-muted">
                      {{this.subtitle}}
                    </small>

                  </td>

                  <td>
                    <span class="badge badge-{{this.status}}">
                      {{this.status}}
                    </span>
                  </td>

                  <td>
                    <small>
                      {{#if this.deadline}}
                        {{this.deadline}}
                      {{else}}
                        <span class="text-muted">—</span>
                      {{/if}}
                    </small>
                  </td>

                  <td>
                    <small>{{this.views}}</small>
                  </td>

                  <td>
                    <small>{{this.createdAt}}</small>
                  </td>

                  <td class="text-end">

                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end align-items-center">

                      <!-- Quick status switch -->

                      <form
                        class="status-form d-inline"
                        action="/admin/{{../entity}}/{{this.id}}/status"
                        method="POST"
                      >

                        <select
                          name="status"
                          class="form-select form-select-sm d-inline-block w-auto"
                          onchange="this.form.submit()"
                        >

                          {{#each ../statuses}}

                            <option value="{{this}}" {{#ifEquals this ../status}}selected{{/ifEquals}}>
                              {{this}}
                            </option>

                          {{/each}}

                        </select>

                      </form>

                      {{#if this.editUrl}}

                        <a class="btn btn-outline-primary btn-sm" href="{{this.editUrl}}">
                          <i class="bi bi-pencil"></i>
                          Edit
                        </a>

                      {{/if}}

                      {{#ifEquals this.status "archived"}}

                        {{#ifEquals ../entity "jobs"}}

                          <!-- Undo archive: back to draft for review -->

                          <form
                            action="/admin/{{../entity}}/{{this.id}}/status"
                            method="POST"
                            class="d-inline"
                          >

                            <input type="hidden" name="status" value="draft" />

                            <button
                              type="submit"
                              class="btn btn-outline-success btn-sm"
                              title="Restore this job as a draft"
                            >
                              <i class="bi bi-arrow-counterclockwise"></i>
                              Restore
                            </button>

                          </form>

                        {{/ifEquals}}

                      {{/ifEquals}}

                      <a class="btn btn-outline-secondary btn-sm" href="{{this.detailUrl}}">
                        <i class="bi bi-eye"></i>
                      </a>

                      <!-- Delete (POST + confirm): jobs are archived and
                           restorable; other entities are permanent -->

                      <form
                        action="/admin/{{../entity}}/{{this.id}}/delete"
                        method="POST"
                        onsubmit="return confirm('{{#ifEquals ../entity "jobs"}}Archive{{else}}Delete{{/ifEquals}} &quot;{{safeConfirmText this.title}}&quot;? {{#ifEquals ../entity "jobs"}}It will be hidden from the public site but kept for reference - you can restore it afterwards.{{else}}This permanently removes it and cannot be undone.{{/ifEquals}}');"
                      >

                        <button type="submit" class="btn btn-outline-danger btn-sm">
                          <i class="bi bi-trash"></i>
                        </button>

                      </form>

                    </div>

                  </td>

                </tr>

              {{else}}

                <tr>

                  <td colspan="6" class="text-center text-muted py-5">

                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                    No {{entityTitle}} yet.

                  </td>

                </tr>

              {{/each}}

            </tbody>

          </table>

        </div>

      </div>

    </main>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>

</html>
