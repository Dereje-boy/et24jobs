<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Latest Jobs in Ethiopia | ET24Jobs</title>
    <meta name="description" content="Browse the latest job opportunities in Ethiopia on ET24Jobs.">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://et24jobs.com/jobs">
    <style>
        :root {
            --primary: #155eef;
            --primary-dark: #1047b8;
            --text: #172033;
            --muted: #667085;
            --border: #e4e7ec;
            --bg: #f7f9fc;
            --white: #fff;
            --success: #067647;
            --danger: #b42318;
            --shadow: 0 4px 18px rgba(16, 24, 40, .07);
            --radius: 12px
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6
        }

        a {
            text-decoration: none;
            color: inherit
        }

        button,
        input,
        select {
            font: inherit
        }

        .container {
            width: min(1180px, calc(100% - 32px));
            margin: auto
        }

        .topbar {
            background: #fff;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1000
        }

        .navbar {
            min-height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 800;
            font-size: 24px;
            letter-spacing: -.5px
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            border-radius: 9px;
            display: grid;
            place-items: center;
            background: var(--primary);
            color: #fff;
            font-size: 18px
        }

        .brand span {
            color: var(--primary)
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 6px
        }

        .nav-links a {
            padding: 9px 13px;
            border-radius: 8px;
            color: #344054;
            font-size: 14px;
            font-weight: 600
        }

        .nav-links a:hover,
        .nav-links a.active {
            background: #eff4ff;
            color: var(--primary)
        }

        .post-job-btn {
            background: var(--primary) !important;
            color: #fff !important
        }

        .menu-btn {
            display: none;
            border: 0;
            background: transparent;
            font-size: 25px;
            cursor: pointer
        }

        .page-hero {
            background: linear-gradient(135deg, #0f3f9f 0%, #155eef 55%, #2f80ed 100%);
            color: #fff;
            padding: 48px 0 55px
        }

        .breadcrumb {
            display: flex;
            gap: 7px;
            color: #dbe7ff;
            font-size: 13px;
            margin-bottom: 18px
        }

        .breadcrumb a:hover {
            text-decoration: underline;
            color: #fff
        }

        .page-hero h1 {
            font-size: clamp(30px, 4vw, 42px);
            line-height: 1.15;
            margin-bottom: 10px
        }

        .page-hero p {
            color: #e5edff;
            font-size: 16px
        }

        .filter-wrapper {
            margin-top: -25px;
            position: relative;
            z-index: 5
        }

        .filter-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 17px;
            box-shadow: var(--shadow)
        }

        .filter-grid {
            display: grid;
            grid-template-columns: 1.7fr 1fr 1fr 1fr auto;
            gap: 10px
        }

        .field {
            min-height: 48px;
            border: 1px solid var(--border);
            border-radius: 8px;
            display: flex;
            background: #fff
        }

        .field input,
        .field select {
            width: 100%;
            border: 0;
            outline: 0;
            padding: 0 12px;
            background: transparent;
            color: var(--text);
            font-size: 14px
        }

        .search-button {
            border: 0;
            border-radius: 8px;
            background: var(--primary);
            color: #fff;
            padding: 0 20px;
            min-height: 48px;
            cursor: pointer;
            font-weight: 700
        }

        .search-button:hover {
            background: var(--primary-dark)
        }

        .filter-footer {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            margin-top: 12px
        }

        .active-filter-text {
            color: var(--muted);
            font-size: 12px
        }

        .clear-filter {
            color: var(--primary);
            font-size: 12px;
            font-weight: 700
        }

        .ad-container {
            padding: 22px 0
        }

        .ad-placeholder {
            min-height: 90px;
            border: 1px dashed #cfd4dc;
            background: #f2f4f7;
            color: #98a2b3;
            display: grid;
            place-items: center;
            border-radius: 8px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .5px
        }

        main {
            padding-bottom: 60px
        }

        .listing-layout {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 290px;
            gap: 25px;
            align-items: start
        }

        .results-header {
            display: flex;
            justify-content: space-between;
            align-items: end;
            gap: 20px;
            margin-bottom: 17px
        }

        .results-header h2 {
            font-size: 24px
        }

        .results-count {
            color: var(--muted);
            font-size: 13px
        }

        .sort-box {
            display: flex;
            align-items: center;
            gap: 8px
        }

        .sort-box label {
            color: var(--muted);
            font-size: 12px
        }

        .sort-box select {
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 7px;
            padding: 8px 10px;
            outline: 0;
            color: var(--text);
            font-size: 12px
        }

        .job-list {
            display: flex;
            flex-direction: column;
            gap: 14px
        }

        .job-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 19px;
            transition: .2s
        }

        .job-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow);
            border-color: #c8d4ef
        }

        .job-card-main {
            display: grid;
            grid-template-columns: 52px minmax(0, 1fr);
            gap: 15px
        }

        .company-logo {
            width: 52px;
            height: 52px;
            border-radius: 10px;
            background: #eff4ff;
            color: var(--primary);
            display: grid;
            place-items: center;
            font-size: 18px;
            font-weight: 800
        }

        .job-title-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px
        }

        .job-title {
            font-size: 18px;
            line-height: 1.35;
            margin-bottom: 3px
        }

        .job-title a:hover {
            color: var(--primary)
        }

        .job-type {
            display: inline-block;
            padding: 4px 8px;
            border-radius: 999px;
            background: #ecfdf3;
            color: var(--success);
            font-size: 10px;
            font-weight: 700;
            white-space: nowrap
        }

        .company-name {
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 10px
        }

        .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 7px 16px;
            color: #475467;
            font-size: 12px;
            margin-bottom: 10px
        }

        .job-description {
            color: #667085;
            font-size: 13px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden
        }

        .job-footer {
            margin-top: 15px;
            padding-top: 13px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px
        }

        .job-posted {
            color: var(--muted);
            font-size: 11px
        }

        .job-deadline {
            color: var(--danger);
            font-size: 11px;
            font-weight: 600
        }

        .job-deadline.expired {
            color: var(--muted)
        }

        .job-details {
            color: var(--primary);
            font-size: 13px;
            font-weight: 700
        }

        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 18px
        }

        .sidebar-card {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px
        }

        .sidebar-card h3 {
            font-size: 16px;
            margin-bottom: 13px
        }

        .category-list {
            list-style: none
        }

        .category-list li {
            border-bottom: 1px solid #f0f1f3
        }

        .category-list li:last-child {
            border: 0
        }

        .category-list a {
            padding: 9px 0;
            display: flex;
            justify-content: space-between;
            color: #475467;
            font-size: 13px
        }

        .category-list a:hover {
            color: var(--primary)
        }

        .category-count {
            color: #98a2b3;
            font-size: 11px
        }

        .quick-links {
            display: flex;
            flex-direction: column;
            gap: 8px
        }

        .quick-link {
            background: #f8faff;
            border: 1px solid #e7edff;
            border-radius: 8px;
            padding: 10px 12px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700
        }

        .empty-state {
            background: #fff;
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 55px 25px;
            text-align: center
        }

        .empty-icon {
            width: 58px;
            height: 58px;
            margin: 0 auto 15px;
            display: grid;
            place-items: center;
            border-radius: 50%;
            background: #eff4ff;
            color: var(--primary);
            font-size: 22px
        }

        .empty-state h3 {
            font-size: 20px
        }

        .empty-state p {
            color: var(--muted);
            font-size: 13px;
            max-width: 480px;
            margin: 6px auto 17px
        }

        .empty-state a {
            display: inline-block;
            background: var(--primary);
            color: #fff;
            border-radius: 8px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700
        }

        .pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 6px;
            margin-top: 25px
        }

        .pagination a,
        .pagination span {
            min-width: 36px;
            height: 36px;
            padding: 0 10px;
            display: grid;
            place-items: center;
            border: 1px solid var(--border);
            background: #fff;
            border-radius: 7px;
            color: #475467;
            font-size: 12px
        }

        .pagination .active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            font-weight: 700
        }

        .pagination .disabled {
            color: #c0c5cd;
            background: #f9fafb
        }

        footer {
            background: #101828;
            color: #fff;
            padding: 45px 0 25px
        }

        .footer-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 40px
        }

        .footer-brand p {
            color: #98a2b3;
            max-width: 380px;
            font-size: 13px;
            margin-top: 12px
        }

        footer h3 {
            font-size: 14px;
            margin-bottom: 13px
        }

        footer ul {
            list-style: none
        }

        footer li {
            margin-bottom: 8px
        }

        footer li a {
            color: #98a2b3;
            font-size: 13px
        }

        footer li a:hover {
            color: #fff
        }

        .copyright {
            border-top: 1px solid #344054;
            margin-top: 35px;
            padding-top: 18px;
            color: #98a2b3;
            font-size: 12px;
            text-align: center
        }

        @media(max-width:1050px) {
            .filter-grid {
                grid-template-columns: 1.5fr 1fr 1fr
            }

            .search-button {
                width: 100%
            }

            .listing-layout {
                grid-template-columns: minmax(0, 1fr) 250px
            }
        }

        @media(max-width:850px) {
            .listing-layout {
                grid-template-columns: 1fr
            }

            .sidebar {
                display: grid;
                grid-template-columns: 1fr 1fr
            }

            .footer-grid {
                grid-template-columns: 1.5fr 1fr 1fr
            }
        }

        @media(max-width:700px) {
            .navbar {
                min-height: 62px
            }

            .menu-btn {
                display: block
            }

            .nav-links {
                display: none;
                position: absolute;
                top: 62px;
                left: 0;
                right: 0;
                background: #fff;
                border-bottom: 1px solid var(--border);
                padding: 10px 16px 16px;
                flex-direction: column;
                align-items: stretch
            }

            .nav-links.active {
                display: flex
            }

            .nav-links a {
                width: 100%
            }

            .page-hero {
                padding: 38px 0 50px
            }

            .filter-wrapper {
                margin-top: -20px
            }

            .filter-grid {
                grid-template-columns: 1fr
            }

            .filter-footer,
            .results-header,
            .job-footer {
                align-items: flex-start;
                flex-direction: column
            }

            .job-card-main {
                grid-template-columns: 44px minmax(0, 1fr);
                gap: 11px
            }

            .company-logo {
                width: 44px;
                height: 44px;
                font-size: 15px
            }

            .job-title-row {
                flex-direction: column;
                gap: 7px
            }

            .job-type {
                align-self: flex-start
            }

            .sidebar {
                grid-template-columns: 1fr
            }

            .footer-grid {
                grid-template-columns: 1fr 1fr
            }

            .footer-brand {
                grid-column: 1/-1
            }
        }

        @media(max-width:430px) {
            .footer-grid {
                grid-template-columns: 1fr
            }

            .footer-brand {
                grid-column: auto
            }

            .pagination a,
            .pagination span {
                min-width: 32px;
                height: 32px;
                padding: 0 7px
            }
        }
    </style>
</head>

<body>

    <header class="topbar">
        <div class="container navbar">
            <a href="/" class="brand">
                <div class="brand-mark">ET</div>
                <div>ET24<span>Jobs</span></div>
            </a>
            <button class="menu-btn" id="menuBtn" aria-label="Open navigation">☰</button>
            <nav class="nav-links" id="navLinks">
                <a href="/">Home</a><a href="/jobs" class="active">Jobs</a><a href="/scholarships">Scholarships</a><a
                    href="/internships">Internships</a><a href="/about">About</a><a href="/post-job"
                    class="post-job-btn">Post a Job</a>
            </nav>
        </div>
    </header>

    <section class="page-hero">
        <div class="container">
            <div class="breadcrumb"><a href="/">Home</a><span>›</span><span>Jobs</span></div>
            <h1>Latest Jobs in Ethiopia</h1>
            <p>Browse recently posted job opportunities from organizations hiring in Ethiopia.</p>
        </div>
    </section>

    <div class="container filter-wrapper">
        <form class="filter-card" action="/jobs" method="GET">
            <div class="filter-grid">
                <div class="field"><input type="search" name="q" value="{{query}}"
                        placeholder="Search jobs, organizations or keywords"></div>
                <div class="field"><select name="category">
                        <option value="">All categories</option>{{#each categories}}<option value="{{id}}" {{#ifEquals
                            id ../selectedCategory}}selected{{/ifEquals}}>{{name}}</option>{{/each}}
                    </select></div>
                <div class="field"><select name="location">
                        <option value="">All locations</option>{{#each locations}}<option value="{{this}}" {{#ifEquals
                            this ../selectedLocation}}selected{{/ifEquals}}>{{this}}</option>{{/each}}
                    </select></div>
                <div class="field"><select name="type">
                        <option value="">All job types</option>
                        <option value="full-time" {{#ifEquals selectedType "full-time" }}selected{{/ifEquals}}>Full Time
                        </option>
                        <option value="part-time" {{#ifEquals selectedType "part-time" }}selected{{/ifEquals}}>Part Time
                        </option>
                        <option value="contract" {{#ifEquals selectedType "contract" }}selected{{/ifEquals}}>Contract
                        </option>
                        <option value="temporary" {{#ifEquals selectedType "temporary" }}selected{{/ifEquals}}>Temporary
                        </option>
                    </select></div>
                <button class="search-button" type="submit">Search</button>
            </div>
            <div class="filter-footer">
                <div class="active-filter-text">{{#if query}}Results for "{{query}}"{{else}}Showing the latest
                    opportunities{{/if}}</div>{{#if hasFilters}}<a href="/jobs" class="clear-filter">Clear
                    filters</a>{{/if}}
            </div>
        </form>
    </div>

    <main>
        <div class="container ad-container">
            <div class="ad-placeholder">Advertisement</div>
        </div>

        <div class="container">
            <div class="listing-layout">

                <section>
                    <div class="results-header">
                        <div>
                            <h2>Job Opportunities</h2>
                            <div class="results-count">{{totalJobs}} job{{#unless (eq totalJobs 1)}}s{{/unless}} found
                            </div>
                        </div>

                        <form action="/jobs" method="GET" class="sort-box">
                            {{#if query}}<input type="hidden" name="q" value="{{query}}">{{/if}}
                            {{#if selectedCategory}}<input type="hidden" name="category"
                                value="{{selectedCategory}}">{{/if}}
                            {{#if selectedLocation}}<input type="hidden" name="location"
                                value="{{selectedLocation}}">{{/if}}
                            {{#if selectedType}}<input type="hidden" name="type" value="{{selectedType}}">{{/if}}
                            <label for="sort">Sort:</label>
                            <select id="sort" name="sort" onchange="this.form.submit()">
                                <option value="newest" {{#ifEquals sort "newest" }}selected{{/ifEquals}}>Newest first
                                </option>
                                <option value="oldest" {{#ifEquals sort "oldest" }}selected{{/ifEquals}}>Oldest first
                                </option>
                                <option value="deadline" {{#ifEquals sort "deadline" }}selected{{/ifEquals}}>Deadline
                                </option>
                            </select>
                        </form>
                    </div>

                    {{#if jobs}}
                    <div class="job-list">
                        {{#each jobs}}
                        <article class="job-card">
                            <div class="job-card-main">
                                <div class="company-logo">{{companyInitials}}</div>
                                <div>
                                    <div class="job-title-row">
                                        <h3 class="job-title"><a href="/jobs/{{slug}}">{{title}}</a></h3>
                                        <span class="job-type">{{employmentType}}</span>
                                    </div>
                                    <div class="company-name">{{companyName}}</div>
                                    <div class="job-meta"><span>📍 {{location}}</span><span>💼
                                            {{categoryName}}</span>{{#if salary}}<span>💰 {{salary}}</span>{{/if}}</div>
                                    <p class="job-description">{{description}}</p>
                                </div>
                            </div>
                            <div class="job-footer">
                                <div><span class="job-posted">Posted {{relativePostedDate}}</span>{{#if deadline}}{{#if
                                        (isExpired deadline)}}<span class="job-deadline expired"> ·
                                        Expired</span>{{else}}<span class="job-deadline"> · Deadline
                                        {{formatDate deadline}}{{#if (eq (daysRemaining deadline) 0)}} · Closes
                                        today{{else}} · {{daysRemaining deadline}}
                                        day{{#unless (eq (daysRemaining deadline) 1)}}s{{/unless}}
                                        left{{/if}}</span>{{/if}}{{/if}}</div>
                                <a href="/jobs/{{slug}}" class="job-details">View job →</a>
                            </div>
                        </article>
                        {{/each}}
                    </div>
JJ
                    {{#if pagination.totalPages}}
                    <nav class="pagination" aria-label="Job pagination">
                        {{#if pagination.hasPrevious}}<a href="{{pagination.previousUrl}}"
                            aria-label="Previous page">‹</a>{{else}}<span class="disabled">‹</span>{{/if}}
                        {{#each pagination.pages}}{{#if active}}<span class="active">{{number}}</span>{{else}}<a
                            href="{{url}}">{{number}}</a>{{/if}}{{/each}}
                        {{#if pagination.hasNext}}<a href="{{pagination.nextUrl}}"
                            aria-label="Next page">›</a>{{else}}<span class="disabled">›</span>{{/if}}
                    </nav>
                    {{/if}}

                    {{else}}
                    <div class="empty-state">
                        <div class="empty-icon">⌕</div>
                        <h3>No jobs found</h3>
                        <p>We couldn't find any jobs matching your search. Try changing your keywords, category,
                            location or employment type.</p>
                        <a href="/jobs">View all jobs</a>
                    </div>
                    {{/if}}
                </section>

                <aside class="sidebar">
                    <div class="sidebar-card">
                        <h3>Job Categories</h3>
                        <ul class="category-list">
                            {{#each categories}}<li><a href="/jobs?category={{id}}"><span>{{name}}</span><span
                                        class="category-count">{{jobCount}}</span></a></li>{{/each}}
                        </ul>
                    </div>

                    <div class="sidebar-card">
                        <h3>Quick Links</h3>
                        <div class="quick-links">
                            <a href="/jobs?sort=newest" class="quick-link">Latest Jobs</a>
                            <a href="/jobs?type=full-time" class="quick-link">Full-Time Jobs</a>
                            <a href="/jobs?type=part-time" class="quick-link">Part-Time Jobs</a>
                            <a href="/jobs?type=contract" class="quick-link">Contract Jobs</a>
                            <a href="/jobs?location=Remote" class="quick-link">Remote Jobs</a>
                        </div>
                    </div>

                    <div class="sidebar-card">
                        <div class="ad-placeholder" style="min-height:220px">Advertisement</div>
                    </div>
                </aside>

            </div>

            <div class="ad-container">
                <div class="ad-placeholder">Advertisement</div>
            </div>
        </div>
    </main>

    <footer>
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="brand">
                        <div class="brand-mark">ET</div>
                        <div>ET24<span>Jobs</span></div>
                    </div>
                    <p>ET24Jobs helps job seekers, students and professionals discover jobs, scholarships and
                        internships in Ethiopia and beyond.</p>
                </div>
                <div>
                    <h3>Opportunities</h3>
                    <ul>
                        <li><a href="/jobs">Jobs</a></li>
                        <li><a href="/scholarships">Scholarships</a></li>
                        <li><a href="/internships">Internships</a></li>
                        <li><a href="/categories">Categories</a></li>
                    </ul>
                </div>
                <div>
                    <h3>ET24Jobs</h3>
                    <ul>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/contact">Contact</a></li>
                        <li><a href="/post-job">Post a Job</a></li>
                    </ul>
                </div>
                <div>
                    <h3>Legal</h3>
                    <ul>
                        <li><a href="/privacy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms & Conditions</a></li>
                    </ul>
                </div>
            </div>
            <div class="copyright">© 2026 ET24Jobs.com. All rights reserved.</div>
        </div>
    </footer>

    <script>
        const menuBtn = document.getElementById("menuBtn");
        const navLinks = document.getElementById("navLinks");
        menuBtn.addEventListener("click", () => navLinks.classList.toggle("active"));
    </script>
</body>

