            </a>

            <a href="/category/health" class="category-card">
              <div class="category-icon">HE</div>
              <strong>Health</strong>
              <small>128 opportunities</small>
            </a>

            <a href="/category/business" class="category-card">
              <div class="category-icon">BU</div>
              <strong>Business</strong>
              <small>104 opportunities</small>
            </a>

            <a href="/category/teaching" class="category-card">
              <div class="category-icon">ED</div>
              <strong>Teaching</strong>
              <small>96 opportunities</small>
            </a>

          </div>
        </section>

        <!-- Jobs -->
        <section class="section">

          <div class="section-header">
            <div>
              <h2>Latest Jobs</h2>
              <p>Recently published job opportunities.</p>
            </div>

            <a href="/jobs" class="view-all">View all jobs →</a>
          </div>

          <div class="listing-grid">

            <article class="listing-card">
              <div class="listing-top">
                <div class="company-logo">AB</div>
                <span class="badge">Full Time</span>
              </div>

              <h3>
                <a href="/jobs/software-developer-addis-ababa-123">
                  Software Developer
                </a>
              </h3>

              <div class="company">ABC Technology</div>

              <div class="meta">
