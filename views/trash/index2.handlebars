<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>ET24Jobs - Jobs, Scholarships & Internships in Ethiopia</title>
    <meta
      name="description"
      content="Find the latest jobs, scholarships and internship opportunities in Ethiopia on ET24Jobs. Search opportunities by keyword, category and location."
    />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://et24jobs.com/" />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content="ET24Jobs - Jobs, Scholarships & Internships in Ethiopia"
    />
    <meta
      property="og:description"
      content="Find jobs, scholarships and internships in Ethiopia."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://et24jobs.com/" />

    <!--
        MONETAG:
        Add your actual Monetag code here after creating your publisher account
        and receiving the appropriate ad tag.
    -->

    <style>
      :root {
        --primary: #155eef;
        --primary-dark: #1047b8;
        --text: #172033;
        --muted: #667085;
        --border: #e4e7ec;
        --background: #f7f9fc;
        --white: #ffffff;
        --success: #067647;
        --warning: #b54708;
        --shadow: 0 4px 18px rgba(16, 24, 40, 0.07);
        --radius: 12px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: Arial, Helvetica, sans-serif;
        background: var(--background);
        color: var(--text);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      img {
        max-width: 100%;
        display: block;
      }

      .container {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
      }

      /* Header */
      .topbar {
        background: var(--white);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      .navbar {
        min-height: 70px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 800;
        font-size: 24px;
        letter-spacing: -0.5px;
        white-space: nowrap;
      }

      .brand-mark {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        display: grid;
        place-items: center;
        background: var(--primary);
        color: white;
        font-size: 18px;
        font-weight: 800;
      }

      .brand span {
        color: var(--primary);
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .nav-links a {
        padding: 9px 13px;
        border-radius: 8px;
        color: #344054;
        font-size: 14px;
        font-weight: 600;
      }

      .nav-links a:hover {
        background: #eff4ff;
        color: var(--primary);
      }

      .post-job-btn {
        background: var(--primary) !important;
        color: white !important;
      }

      .post-job-btn:hover {
        background: var(--primary-dark) !important;
      }

      .menu-btn {
        display: none;
        border: 0;
        background: transparent;
        font-size: 25px;
        cursor: pointer;
      }

      /* Hero */
      .hero {
        background: linear-gradient(
          135deg,
          #0f3f9f 0%,
          #155eef 55%,
          #2f80ed 100%
        );
        color: white;
        padding: 70px 0 78px;
      }

      .hero-content {
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
      }

      .hero h1 {
        font-size: clamp(32px, 5vw, 52px);
        line-height: 1.1;
        letter-spacing: -1.5px;
        margin-bottom: 16px;
      }

      .hero p {
        font-size: 18px;
        color: #e5edff;
        margin-bottom: 30px;
      }

      .search-box {
        background: white;
        padding: 8px;
        border-radius: 12px;
        display: grid;
        grid-template-columns: 1.5fr 1fr auto;
        gap: 8px;
        box-shadow: 0 12px 35px rgba(0, 0, 0, 0.18);
        text-align: left;
      }

      .search-field {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 0 14px;
        min-height: 52px;
        border-right: 1px solid var(--border);
      }

      .search-field:last-of-type {
        border-right: 0;
      }

      .search-icon {
        color: var(--muted);
        font-size: 18px;
      }

      .search-field input,
      .search-field select {
        width: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        font-size: 15px;
        color: var(--text);
      }

      .search-btn {
        border: 0;
        border-radius: 9px;
        padding: 0 25px;
        background: var(--primary);
        color: white;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
      }

      .search-btn:hover {
        background: var(--primary-dark);
      }

      /* Ad placeholder */
      .ad-container {
        padding: 22px 0;
      }

      .ad-placeholder {
        min-height: 90px;
        border: 1px dashed #cfd4dc;
        background: #f2f4f7;
        color: #98a2b3;
        display: grid;
        place-items: center;
        border-radius: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
      }

      /* Main */
      main {
        padding-bottom: 60px;
      }

      .section {
        padding-top: 42px;
      }

      .section-header {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
      }

      .section-header h2 {
        font-size: 26px;
        letter-spacing: -0.5px;
      }

      .section-header p {
        color: var(--muted);
        font-size: 14px;
        margin-top: 3px;
      }

      .view-all {
        color: var(--primary);
        font-weight: 700;
        font-size: 14px;
        white-space: nowrap;
      }

      .view-all:hover {
        text-decoration: underline;
      }

      /* Category cards */
      .category-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 12px;
      }

      .category-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 18px 12px;
        text-align: center;
        transition: 0.2s ease;
      }

      .category-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
        border-color: #b8c7ef;
      }

      .category-icon {
        width: 42px;
        height: 42px;
        margin: 0 auto 9px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #eff4ff;
        color: var(--primary);
        font-size: 18px;
        font-weight: 800;
      }

      .category-card strong {
        display: block;
        font-size: 13px;
      }

      .category-card small {
        color: var(--muted);
        font-size: 11px;
      }

      /* Listing cards */
      .listing-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
      }

      .listing-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 20px;
        box-shadow: 0 1px 2px rgba(16, 24, 40, 0.02);
        transition: 0.2s ease;
      }

      .listing-card:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow);
      }

      .listing-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
      }

      .company-logo {
        width: 46px;
        height: 46px;
        border-radius: 9px;
        background: #eff4ff;
        color: var(--primary);
        display: grid;
        place-items: center;
        font-size: 17px;
        font-weight: 800;
        flex-shrink: 0;
      }

      .badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 999px;
        background: #ecfdf3;
        color: var(--success);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
      }

      .listing-card h3 {
        font-size: 17px;
        line-height: 1.35;
        margin-bottom: 5px;
      }

      .company {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 13px;
      }

      .meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 14px;
        color: #475467;
        font-size: 12px;
        margin-bottom: 16px;
      }

      .listing-description {
        color: #667085;
        font-size: 13px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 17px;
      }

      .card-footer {
        padding-top: 14px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }

      .deadline {
        font-size: 11px;
        color: var(--muted);
      }

      .details-btn {
        color: var(--primary);
        font-size: 13px;
        font-weight: 700;
      }

      .details-btn:hover {
        text-decoration: underline;
      }

      /* Featured statistics */
      .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
        margin-top: 28px;
      }

      .stat {
        background: white;
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 22px;
        text-align: center;
      }

      .stat-number {
        font-size: 28px;
        font-weight: 800;
        color: var(--primary);
      }

      .stat-label {
        color: var(--muted);
        font-size: 13px;
      }

      /* CTA */
      .cta {
        margin-top: 45px;
        border-radius: 16px;
        background: #101828;
        color: white;
        padding: 38px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
      }

      .cta h2 {
        font-size: 25px;
        margin-bottom: 6px;
      }

      .cta p {
        color: #d0d5dd;
        font-size: 14px;
      }

      .cta-btn {
        background: white;
        color: #101828;
        padding: 11px 18px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        white-space: nowrap;
      }

      /* Footer */
      footer {
        background: #101828;
        color: white;
        padding: 45px 0 25px;
      }

      .footer-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr;
        gap: 40px;
      }

      .footer-brand p {
        color: #98a2b3;
        max-width: 380px;
        font-size: 13px;
        margin-top: 12px;
      }

      footer h3 {
        font-size: 14px;
        margin-bottom: 13px;
      }

      footer ul {
        list-style: none;
      }

      footer li {
        margin-bottom: 8px;
      }

      footer li a {
        color: #98a2b3;
        font-size: 13px;
      }

      footer li a:hover {
        color: white;
      }

      .copyright {
        border-top: 1px solid #344054;
        margin-top: 35px;
        padding-top: 18px;
        color: #98a2b3;
        font-size: 12px;
        text-align: center;
      }

      /* Mobile */
      @media (max-width: 900px) {
        .category-grid {
          grid-template-columns: repeat(3, 1fr);
        }

        .listing-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .footer-grid {
          grid-template-columns: 1.5fr 1fr 1fr;
        }
      }

      @media (max-width: 700px) {
        .navbar {
          min-height: 62px;
        }

        .menu-btn {
          display: block;
        }

        .nav-links {
          display: none;
          position: absolute;
          top: 62px;
          left: 0;
          right: 0;
          background: white;
          border-bottom: 1px solid var(--border);
          padding: 10px 16px 16px;
          flex-direction: column;
          align-items: stretch;
        }

        .nav-links.active {
          display: flex;
        }

        .nav-links a {
          width: 100%;
        }

        .hero {
          padding: 50px 0 55px;
        }

        .hero h1 {
          font-size: 34px;
        }

        .hero p {
          font-size: 15px;
        }

        .search-box {
          grid-template-columns: 1fr;
        }

        .search-field {
          border-right: 0;
          border-bottom: 1px solid var(--border);
        }

        .search-btn {
          min-height: 50px;
        }

        .category-grid,
        .listing-grid,
        .stats {
          grid-template-columns: 1fr;
        }

        .section {
          padding-top: 34px;
        }

        .section-header {
          align-items: start;
        }

        .section-header h2 {
          font-size: 22px;
        }

        .cta {
          padding: 28px 22px;
          flex-direction: column;
          align-items: flex-start;
        }

        .footer-grid {
          grid-template-columns: 1fr 1fr;
        }

        .footer-brand {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 430px) {
        .category-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .footer-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>

    <header class="topbar">
      <div class="container navbar">

        <a href="/" class="brand" aria-label="ET24Jobs Home">
          <div class="brand-mark">ET</div>
          <div>ET24<span>Jobs</span></div>
        </a>

        <button class="menu-btn" id="menuBtn" aria-label="Open navigation">
          ☰
        </button>

        <nav class="nav-links" id="navLinks">
          <a href="/">Home</a>
          <a href="/jobs">Jobs</a>
          <a href="/scholarships">Scholarships</a>
          <a href="/internships">Internships</a>
          <a href="/about">About</a>
          <a href="/post-job" class="post-job-btn">Post a Job</a>
        </nav>

      </div>
    </header>

    <section class="hero">
      <div class="container hero-content">

        <h1>Find Your Next Opportunity</h1>

        <p>
          Discover jobs, scholarships and internships in Ethiopia.
        </p>

        <form class="search-box" action="/search" method="GET">

          <div class="search-field">
            <span class="search-icon">⌕</span>
            <input
              type="search"
              name="q"
              placeholder="Job title, keyword or organization"
              aria-label="Search keyword"
            />
          </div>

          <div class="search-field">
            <span class="search-icon">⌖</span>
            <select name="location" aria-label="Location">
              <option value="">All Opportunities</option>
              <option>Jobs</option>
              <option>Scholarships</option>
              <option>Internships</option>
            </select>
          </div>

          <button class="search-btn" type="submit">
            Search
          </button>

        </form>

      </div>
    </section>

    <main>

      <!-- Monetag / advertising area -->
      <div class="container ad-container">
        <div class="ad-placeholder">
          Advertisement
        </div>
      </div>

      <div class="container">

        <!-- Quick categories -->
