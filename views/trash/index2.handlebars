              </p>

              <div class="card-footer">
                <span class="deadline">Deadline: Aug 30, 2026</span>
                <a
                  href="/jobs/project-officer-addis-ababa-125"
                  class="details-btn"
                >
                  View job →
                </a>
              </div>
            </article>

          </div>

        </section>

        <!-- Mid-page advertising -->
        <div class="ad-container">
          <div class="ad-placeholder">
            Advertisement
          </div>
        </div>

        <!-- Scholarships -->
        <section class="section">

          <div class="section-header">
            <div>
              <h2>Latest Scholarships</h2>
              <p>Scholarship opportunities for Ethiopian students and
                professionals.</p>
            </div>

            <a href="/scholarships" class="view-all">
              View all scholarships →
            </a>
          </div>

          <div class="listing-grid">

            <article class="listing-card">
              <div class="listing-top">
                <div class="company-logo">DA</div>
