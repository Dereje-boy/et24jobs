              </p>

              <div class="card-footer">
                <span class="deadline">Deadline: Sep 30, 2026</span>
                <a
                  href="/scholarships/african-union-scholarship-2026"
                  class="details-btn"
                >
                  View scholarship →
                </a>
              </div>
            </article>

            <article class="listing-card">
              <div class="listing-top">
                <div class="company-logo">UN</div>
                <span class="badge">Funding</span>
              </div>

              <h3>
                <a href="/scholarships/international-development-scholarship">
                  International Development Scholarship
                </a>
              </h3>

              <div class="company">Development Program</div>

              <div class="meta">
                <span>🌍 International</span>
                <span>🎓 Master's</span>
              </div>

              <p class="listing-description">
                Study funding opportunity for applicants interested in
                development-related fields.
              </p>

              <div class="card-footer">
                <span class="deadline">Deadline: Oct 5, 2026</span>
                <a
                  href="/scholarships/international-development-scholarship"
                  class="details-btn"
                >
                  View scholarship →
                </a>
              </div>
            </article>

          </div>

        </section>

        <!-- Internships -->
        <section class="section">

          <div class="section-header">
            <div>
              <h2>Latest Internships</h2>
              <p>Start building professional experience.</p>
            </div>

            <a href="/internships" class="view-all">
              View all internships →
