            </article>

            <article class="listing-card">
              <div class="listing-top">
                <div class="company-logo">XY</div>
                <span class="badge">Full Time</span>
              </div>

              <h3>
                <a href="/jobs/accountant-hawassa-124">
                  Accountant
                </a>
              </h3>

              <div class="company">XYZ Organization</div>

              <div class="meta">
                <span>📍 Hawassa</span>
                <span>💼 Finance</span>
              </div>

              <p class="listing-description">
                Accounting position involving financial reporting,
