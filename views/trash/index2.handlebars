                <div class="company-logo">AU</div>
                <span class="badge">Scholarship</span>
              </div>

              <h3>
                <a href="/scholarships/african-union-scholarship-2026">
                  African Union Scholarship
                </a>
              </h3>

              <div class="company">African Union</div>

              <div class="meta">
                <span>🌍 Africa</span>
                <span>🎓 Postgraduate</span>
              </div>

              <p class="listing-description">
                Funding opportunity for African students in selected academic
