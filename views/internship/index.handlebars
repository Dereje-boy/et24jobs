<title>Internships | ET24Jobs</title>

<meta
  name="description"
  content="Find the latest internships and training opportunities on ET24Jobs."
/>

<style>
  body {
    background: #f5f7fb;
    font-family: Arial, Helvetica, sans-serif;
    color: #1f2937;
  }

  /* =========================
           NAVBAR
        ========================= */

  .navbar {
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .navbar-brand {
    font-size: 1.45rem;
    font-weight: 800;
    color: #2563eb !important;
  }

  .navbar-brand span {
    color: #111827;
  }

  .nav-link {
    color: #374151 !important;
    font-weight: 500;
    margin-left: 10px;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #2563eb !important;
  }

  /* =========================
           HERO
        ========================= */

  .internship-hero {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);

    color: white;

    padding: 55px 20px;

    border-radius: 0 0 25px 25px;
  }

  .internship-hero h1 {
    font-size: 2.4rem;

    font-weight: 800;
  }

  .internship-hero p {
    max-width: 650px;

    margin: 15px auto 0;

    opacity: 0.92;

    font-size: 1.05rem;
  }

  /* =========================
           SEARCH
        ========================= */

  .search-box {
    margin-top: -25px;

    position: relative;

    z-index: 5;
  }

  .search-card {
    background: white;

    border-radius: 15px;

    padding: 18px;

    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .search-input {
    border: 1px solid #d1d5db;

    border-radius: 10px;

    height: 48px;
  }

  .search-button {
    height: 48px;

    border-radius: 10px;

    font-weight: 600;
  }

  /* =========================
           SECTION
        ========================= */

  .section-title {
    font-weight: 800;

    color: #111827;
  }

  .result-count {
    color: #6b7280;
  }

  /* =========================
           INTERNSHIP CARD
        ========================= */

  .internship-card {
    background: white;

    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 22px;

    height: 100%;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .internship-card:hover {
    transform: translateY(-4px);

    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .internship-icon {
    width: 50px;

    height: 50px;

    border-radius: 12px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 1.35rem;

    flex-shrink: 0;
  }

  .internship-title {
    font-size: 1.15rem;

    font-weight: 700;

    color: #111827;

    text-decoration: none;
  }

  .internship-title:hover {
    color: #2563eb;
  }

  .organization-name {
    color: #6b7280;

    font-size: 0.9rem;
  }

  /* =========================
           BADGES
        ========================= */

  .internship-badge {
    display: inline-block;

    font-size: 0.78rem;

    font-weight: 600;

    padding: 5px 9px;

    border-radius: 20px;

    background: #eff6ff;

    color: #1d4ed8;
  }

  .internship-badge.location {
    background: #f3f4f6;

    color: #4b5563;
  }

  .internship-badge.field {
    background: #f3e8ff;

    color: #7e22ce;
  }

  /* =========================
           INFO
        ========================= */

  .info-item {
    color: #4b5563;

    font-size: 0.88rem;

    margin-bottom: 7px;
  }

  .info-item i {
    width: 20px;

    color: #2563eb;
  }

  /* =========================
           DESCRIPTION
        ========================= */

  .internship-description {
    color: #6b7280;

    font-size: 0.9rem;

    line-height: 1.55;

    display: -webkit-box;

    -webkit-line-clamp: 3;

    -webkit-box-orient: vertical;

    overflow: hidden;
  }

  /* =========================
           COMPENSATION
        ========================= */

  .compensation {
    background: #f0fdf4;

    color: #166534;

    border-radius: 8px;

    padding: 7px 10px;

    font-size: 0.82rem;

    font-weight: 600;

    display: inline-block;

    margin-top: 5px;
  }

  /* =========================
           DEADLINE
        ========================= */

  .deadline {
    border-top: 1px solid #e5e7eb;

    margin-top: 18px;

    padding-top: 15px;

    color: #6b7280;

    font-size: 0.88rem;
  }

  .deadline strong {
    color: #dc2626;
  }

  /* =========================
           BUTTON
        ========================= */

  .details-button {
    border-radius: 9px;

    font-weight: 600;

    padding: 9px 16px;
  }

  /* =========================
           ADVERTISEMENT
        ========================= */

  .ad-box {
    min-height: 90px;

    background: #ffffff;

    border: 1px dashed #d1d5db;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #9ca3af;

    font-size: 0.8rem;
  }

  /* =========================
           FOOTER
        ========================= */

  footer {
    background: #111827;

    color: #9ca3af;

    margin-top: 60px;

    padding: 40px 20px;
  }

  footer h5 {
    color: white;

    font-weight: 700;
  }

  footer a {
    color: #9ca3af;

    text-decoration: none;
  }

  footer a:hover {
    color: white;
  }

  /* =========================
           MOBILE
        ========================= */

  @media (max-width: 768px) {
    .internship-hero {
      padding: 40px 20px;
    }

    .internship-hero h1 {
      font-size: 1.9rem;
    }

    .search-box {
      margin-top: -15px;
    }
  }
</style>

<!-- =========================
     HERO
========================= -->

<section class="internship-hero text-center">

  <div class="container">

    <h1>
      Find Your Internship
    </h1>

    <p>
      Discover internships, training opportunities and practical experience
      programs from organizations in Ethiopia and beyond.
    </p>

  </div>

</section>

<!-- =========================
     SEARCH
========================= -->

<div class="container search-box">

  <div class="search-card">

    <form action="/internships" method="GET">

      <div class="row g-2">

        <div class="col-md-9">

          <input
            type="search"
            name="q"
            class="form-control search-input"
            placeholder="Search internships, organizations, skills..."
            value="{{searchQuery}}"
          />

        </div>

        <div class="col-md-3">

          <button type="submit" class="btn btn-primary w-100 search-button">

            <i class="bi bi-search"></i>

            Search Internships

          </button>

        </div>

      </div>

    </form>

  </div>

</div>

<!-- =========================
     MAIN CONTENT
========================= -->

<main class="container my-5">

  <!-- Advertisement -->

  <!-- Heading -->

  <div class="d-flex justify-content-between align-items-center mb-4">

    <div>

      <h2 class="section-title mb-1">

        Latest Internships

      </h2>

      <div class="result-count">

        Showing
        {{internships.length}}
        internship opportunities

      </div>

    </div>

  </div>

  <!-- =========================
         INTERNSHIP CARDS
    ========================= -->

  <div class="row g-4">

    {{#each internships}}

      <div class="col-lg-6">

        <article class="internship-card">

          <!-- Header -->

          <div class="d-flex gap-3 mb-3">

            <div class="internship-icon">

              <i class="bi bi-person-workspace"></i>

            </div>

            <div class="flex-grow-1">

              <a href="/internships/{{slug}}" class="internship-title">

                {{title}}

              </a>

              <div class="organization-name mt-1">

                <i class="bi bi-building"></i>

                {{organizationName}}

              </div>

            </div>

          </div>

          <!-- Badges -->

          <div class="mb-3">

            {{#if internshipType}}

              <span class="internship-badge">

                <i class="bi bi-clock"></i>

                {{internshipType}}

              </span>

            {{/if}}

            {{#if location}}

              <span class="internship-badge location ms-1">

                <i class="bi bi-geo-alt"></i>

                {{location}}

              </span>

            {{/if}}

            {{#if fieldOfStudy}}

              <span class="internship-badge field ms-1">

                {{fieldOfStudy}}

              </span>

            {{/if}}

          </div>

          <!-- Information -->

          <div>

            {{#if duration}}

              <div class="info-item">

                <i class="bi bi-calendar3"></i>

                Duration:

                {{duration}}

              </div>

            {{/if}}

            {{#if studyLevel}}

              <div class="info-item">

                <i class="bi bi-mortarboard"></i>

                Study level:

                {{studyLevel}}

              </div>

            {{/if}}

            {{#if location}}

              <div class="info-item">

                <i class="bi bi-pin-map"></i>

                Location:

                {{location}}

              </div>

            {{/if}}

          </div>

          <!-- Compensation -->

          {{#if compensationType}}

            <div>

              <span class="compensation">

                <i class="bi bi-cash-stack"></i>

                {{compensationType}}

                {{#if compensationDetails}}

                  —
                  {{compensationDetails}}

                {{/if}}

              </span>

            </div>

          {{/if}}

          <!-- Description -->

          {{#if description}}

            <p class="internship-description mt-3 mb-0">

              {{description}}

            </p>

          {{/if}}

          <!-- Deadline -->

          <div class="deadline">

            <i class="bi bi-calendar-event"></i>

            Application deadline:

            {{#if deadline}}

              <strong>

                {{deadline}}

              </strong>

            {{else}}

              <strong>

                Not specified

              </strong>

            {{/if}}

          </div>

          <!-- Button -->

          <div class="mt-3">

            <a
              href="/internships/{{slug}}"
              class="btn btn-primary details-button"
            >

              View Internship

              <i class="bi bi-arrow-right"></i>

            </a>

          </div>

        </article>

      </div>

    {{/each}}

  </div>

  <!-- =========================
         EMPTY STATE
    ========================= -->

  {{#unless internships.length}}

    <div class="text-center py-5">

      <div class="mb-3">

        <i
          class="bi bi-person-workspace"
          style="
                    font-size: 3rem;
                    color: #9ca3af;
                "
        ></i>

      </div>

      <h4>

        No internships found

      </h4>

      <p class="text-muted">

        Try searching with a different keyword.

      </p>

    </div>

  {{/unless}}

  <!-- Bottom Advertisement -->

</main>