<!-- =========================
     HERO
========================= -->

    <section class="internship-hero text-center">

      <div class="container">

        <h1>
          Find Your Internship
        </h1>

        <p>
          Discover internships, training opportunities and practical experience
          programs from organizations in Ethiopia and beyond.
        </p>

      </div>

    </section>

    <!-- =========================
     SEARCH
========================= -->

    <div class="container search-box">

      <div class="search-card">

        <form action="/internships" method="GET">

          <div class="row g-2">

            <div class="col-md-9">

              <input
                type="search"
                name="q"
                class="form-control search-input"
                placeholder="Search internships, organizations, skills..."
                value="{{searchQuery}}"
              />

            </div>

            <div class="col-md-3">

              <button type="submit" class="btn btn-primary w-100 search-button">

                <i class="bi bi-search"></i>

                Search Internships

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

    <!-- =========================
     MAIN CONTENT
========================= -->

    <main class="container my-5">

      <!-- Advertisement -->

      <!-- Heading -->

      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

          <h2 class="section-title mb-1">

            Latest Internships

          </h2>

          <div class="result-count">

            Showing
            {{internships.length}}
            internship opportunities

          </div>

        </div>

      </div>

      <!-- =========================
         INTERNSHIP CARDS
    ========================= -->

      <div class="row g-4">

        {{#each internships}}

          <div class="col-lg-6">

            <article class="internship-card">

              <!-- Header -->

              <div class="d-flex gap-3 mb-3">

                <div class="internship-icon">

                  <i class="bi bi-person-workspace"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/internships/{{slug}}" class="internship-title">

                    {{title}}

                  </a>

                  <div class="organization-name mt-1">

                    <i class="bi bi-building"></i>

                    {{organizationName}}

                  </div>

                </div>

              </div>

              <!-- Badges -->

              <div class="mb-3">

                {{#if internshipType}}

                  <span class="internship-badge">

                    <i class="bi bi-clock"></i>

                    {{internshipType}}

                  </span>

                {{/if}}

                {{#if location}}

                  <span class="internship-badge location ms-1">

                    <i class="bi bi-geo-alt"></i>

                    {{location}}

                  </span>

                {{/if}}

                {{#if fieldOfStudy}}

                  <span class="internship-badge field ms-1">

                    {{fieldOfStudy}}

                  </span>

                {{/if}}

              </div>

              <!-- Information -->

              <div>

                {{#if duration}}

                  <div class="info-item">

                    <i class="bi bi-calendar3"></i>

                    Duration:

                    {{duration}}

                  </div>

                {{/if}}

                {{#if studyLevel}}

                  <div class="info-item">

                    <i class="bi bi-mortarboard"></i>

                    Study level:

                    {{studyLevel}}

                  </div>

                {{/if}}

                {{#if location}}

                  <div class="info-item">

                    <i class="bi bi-pin-map"></i>

                    Location:

                    {{location}}

                  </div>

                {{/if}}

              </div>

              <!-- Compensation -->

              {{#if compensationType}}

                <div>

                  <span class="compensation">

                    <i class="bi bi-cash-stack"></i>

                    {{compensationType}}

                    {{#if compensationDetails}}

                      —
                      {{compensationDetails}}

                    {{/if}}

                  </span>

                </div>

              {{/if}}

              <!-- Description -->

              {{#if description}}

                <p class="internship-description mt-3 mb-0">

                  {{description}}

                </p>

              {{/if}}

              <!-- Deadline -->

              <div class="deadline">

                <i class="bi bi-calendar-event"></i>

                Application deadline:

                {{#if deadline}}

                  <strong>

                    {{deadline}}

                  </strong>

                {{else}}

                  <strong>

                    Not specified

                  </strong>

                {{/if}}

              </div>

              <!-- Button -->

              <div class="mt-3">

                <a
                  href="/internships/{{slug}}"
                  class="btn btn-primary details-button"
                >

                  View Internship

                  <i class="bi bi-arrow-right"></i>

                </a>

              </div>

            </article>

          </div>

        {{/each}}

      </div>

      <!-- =========================
         EMPTY STATE
    ========================= -->

      {{#unless internships.length}}

        <div class="text-center py-5">

          <div class="mb-3">

            <i
              class="bi bi-person-workspace"
              style="
                    font-size: 3rem;
                    color: #9ca3af;
                "
            ></i>

          </div>

          <h4>

            No internships found

          </h4>

          <p class="text-muted">

            Try searching with a different keyword.

          </p>

        </div>

      {{/unless}}

      <!-- Bottom Advertisement -->

    </main>
