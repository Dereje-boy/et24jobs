<title>{{internship.title}} | ET24Jobs</title>

<meta
  name="description"
  content="{{internship.title}} internship at {{internship.organizationName}} — eligibility, duration, benefits, deadline and application information on ET24Jobs."
/>

<style>
  /* =========================
           GLOBAL
        ========================= */

  body {
    background: #f5f7fb;

    font-family: Arial, Helvetica, sans-serif;

    color: #1f2937;
  }

  /* =========================
           NAVBAR
        ========================= */

  .navbar {
    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;
  }

  .navbar-brand {
    font-size: 1.45rem;

    font-weight: 800;

    color: #2563eb !important;
  }

  .navbar-brand span {
    color: #111827;
  }

  .nav-link {
    color: #374151 !important;

    font-weight: 500;

    margin-left: 10px;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #2563eb !important;
  }

  /* =========================
           BREADCRUMB
        ========================= */

  .breadcrumb-wrapper {
    background: #ffffff;

    border-bottom: 1px solid #e5e7eb;
  }

  .breadcrumb {
    margin-bottom: 0;

    padding: 14px 0;
  }

  .breadcrumb a {
    color: #2563eb;

    text-decoration: none;
  }

  /* =========================
           ADVERTISEMENT
        ========================= */

  .ad-box {
    min-height: 90px;

    background: #ffffff;

    border: 1px dashed #d1d5db;

    border-radius: 12px;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #9ca3af;

    font-size: 0.8rem;
  }

  /* =========================
           INTERNSHIP HEADER
        ========================= */

  .internship-header {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 16px;

    padding: 28px;

    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.04);
  }

  .internship-icon {
    width: 65px;

    height: 65px;

    border-radius: 14px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 1.7rem;

    flex-shrink: 0;
  }

  .internship-title {
    font-size: 2rem;

    font-weight: 800;

    color: #111827;

    line-height: 1.25;
  }

  .organization-name {
    color: #6b7280;

    font-size: 1rem;
  }

  /* =========================
           BADGES
        ========================= */

  .internship-badge {
    display: inline-block;

    font-size: 0.8rem;

    font-weight: 600;

    padding: 6px 10px;

    border-radius: 20px;

    background: #eff6ff;

    color: #1d4ed8;

    margin-right: 5px;

    margin-bottom: 5px;
  }

  .internship-badge.location {
    background: #f3f4f6;

    color: #4b5563;
  }

  .internship-badge.field {
    background: #f3e8ff;

    color: #7e22ce;
  }

  /* =========================
           CONTENT CARDS
        ========================= */

  .content-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 25px;

    margin-bottom: 22px;
  }

  .section-title {
    font-size: 1.25rem;

    font-weight: 800;

    color: #111827;

    margin-bottom: 18px;
  }

  .internship-description {
    color: #4b5563;

    line-height: 1.75;

    white-space: pre-line;
  }

  /* =========================
           INFORMATION ROWS
        ========================= */

  .info-row {
    display: flex;

    padding: 13px 0;

    border-bottom: 1px solid #f0f0f0;
  }

  .info-row:last-child {
    border-bottom: none;
  }

  .info-label {
    width: 190px;

    font-weight: 600;

    color: #374151;
  }

  .info-value {
    color: #6b7280;

    flex: 1;
  }

  /* =========================
           BENEFITS
        ========================= */

  .benefit-box {
    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    color: #166534;

    border-radius: 10px;

    padding: 15px;

    line-height: 1.7;
  }

  /* =========================
           APPLICATION CARD
        ========================= */

  .apply-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 15px;

    padding: 24px;

    position: sticky;

    top: 20px;
  }

  .apply-title {
    font-size: 1.2rem;

    font-weight: 800;

    color: #111827;
  }

  .deadline-box {
    background: #fff7ed;

    border: 1px solid #fed7aa;

    color: #9a3412;

    border-radius: 10px;

    padding: 13px;

    font-size: 0.9rem;

    margin: 18px 0;
  }

  .compensation-box {
    background: #f0fdf4;

    border: 1px solid #bbf7d0;

    color: #166534;

    border-radius: 10px;

    padding: 13px;

    font-size: 0.9rem;

    margin-bottom: 15px;
  }

  .apply-button {
    width: 100%;

    border-radius: 10px;

    padding: 12px;

    font-weight: 700;

    font-size: 1rem;
  }

  .source-note {
    font-size: 0.78rem;

    color: #9ca3af;

    line-height: 1.5;

    margin-top: 15px;
  }

  /* =========================
           SHARE
        ========================= */

  .share-button {
    border: 1px solid #d1d5db;

    background: #ffffff;

    color: #374151;

    border-radius: 8px;

    padding: 7px 12px;

    font-size: 0.85rem;
  }

  .share-button:hover {
    background: #f3f4f6;
  }

  /* =========================
           RELATED INTERNSHIPS
        ========================= */

  .related-card {
    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 14px;

    padding: 18px;

    height: 100%;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-3px);

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
  }

  .related-icon {
    width: 42px;

    height: 42px;

    border-radius: 10px;

    background: #eff6ff;

    color: #2563eb;

    display: flex;

    align-items: center;

    justify-content: center;

    flex-shrink: 0;
  }

  .related-title {
    color: #111827;

    font-weight: 700;

    text-decoration: none;

    line-height: 1.35;
  }

  .related-title:hover {
    color: #2563eb;
  }

  .related-organization {
    color: #6b7280;

    font-size: 0.85rem;
  }

  .related-info {
    color: #6b7280;

    font-size: 0.82rem;

    margin-top: 10px;
  }

  /* =========================
           FOOTER
        ========================= */

  footer {
    background: #111827;

    color: #9ca3af;

    margin-top: 60px;

    padding: 40px 20px;
  }

  footer h5 {
    color: white;

    font-weight: 700;
  }

  footer a {
    color: #9ca3af;

    text-decoration: none;
  }

  footer a:hover {
    color: white;
  }

  /* =========================
           MOBILE
        ========================= */

  @media (max-width: 768px) {
    .internship-title {
      font-size: 1.55rem;
    }

    .internship-header {
      padding: 20px;
    }

    .content-card {
      padding: 20px;
    }

    .info-row {
      display: block;
    }

    .info-label {
      width: auto;

      margin-bottom: 4px;
    }

    .apply-card {
      position: static;
    }
  }
</style>

<!-- =========================
     BREADCRUMB
========================= -->

<div class="breadcrumb-wrapper">

  <div class="container">

    <nav aria-label="breadcrumb">

      <ol class="breadcrumb">

        <li class="breadcrumb-item">

          <a href="/">

            Home

          </a>

        </li>

        <li class="breadcrumb-item">

          <a href="/internships">

            Internships

          </a>

        </li>

        <li class="breadcrumb-item active" aria-current="page">

          {{internship.title}}

        </li>

      </ol>

    </nav>

  </div>

</div>

<!-- =========================
     MAIN
========================= -->

<main class="container my-4">

  <!-- =========================
         INTERNSHIP HEADER
    ========================= -->

  <section class="internship-header mb-4">

    <div class="d-flex gap-3">

      <div class="internship-icon">

        <i class="bi bi-person-workspace"></i>

      </div>

      <div class="flex-grow-1">

        <h1 class="internship-title mb-2">

          {{internship.title}}

        </h1>

        <div class="organization-name mb-3">

          <i class="bi bi-building"></i>

          {{internship.organizationName}}

        </div>

        <div>

          {{#if internship.internshipType}}

            <span class="internship-badge">

              <i class="bi bi-clock"></i>

              {{internship.internshipType}}

            </span>

          {{/if}}

          {{#if internship.location}}

            <span class="internship-badge location">

              <i class="bi bi-geo-alt"></i>

              {{internship.location}}

            </span>

          {{/if}}

          {{#if internship.fieldOfStudy}}

            <span class="internship-badge field">

              {{internship.fieldOfStudy}}

            </span>

          {{/if}}

        </div>

      </div>

    </div>

    <!-- SHARE -->

    <div class="mt-4 pt-3 border-top">

      <button class="share-button" onclick="shareInternship()">

        <i class="bi bi-share"></i>

        Share Internship

      </button>

    </div>

  </section>

  <!-- =========================
         CONTENT + SIDEBAR
    ========================= -->

  <div class="row g-4">

    <!-- =====================
             LEFT COLUMN
        ====================== -->

    <div class="col-lg-8">

      <!-- Overview -->

      <section class="content-card">

        <h2 class="section-title">

          Internship Overview

        </h2>

        <div class="internship-description">

          {{internship.description}}

        </div>

      </section>

      <!-- Internship Details -->

      <section class="content-card">

        <h2 class="section-title">

          Internship Details

        </h2>

        {{#if internship.organizationName}}

          <div class="info-row">

            <div class="info-label">

              Organization

            </div>

            <div class="info-value">

              {{internship.organizationName}}

            </div>

          </div>

        {{/if}}

        {{#if internship.internshipType}}

          <div class="info-row">

            <div class="info-label">

              Internship Type

            </div>

            <div class="info-value">

              {{internship.internshipType}}

            </div>

          </div>

        {{/if}}

        {{#if internship.location}}

          <div class="info-row">

            <div class="info-label">

              Location

            </div>

            <div class="info-value">

              {{internship.location}}

            </div>

          </div>

        {{/if}}

        {{#if internship.fieldOfStudy}}

          <div class="info-row">

            <div class="info-label">

              Field of Study

            </div>

            <div class="info-value">

              {{internship.fieldOfStudy}}

            </div>

          </div>

        {{/if}}

        {{#if internship.studyLevel}}

          <div class="info-row">

            <div class="info-label">

              Study Level

            </div>

            <div class="info-value">

              {{internship.studyLevel}}

            </div>

          </div>

        {{/if}}

        {{#if internship.duration}}

          <div class="info-row">

            <div class="info-label">

              Duration

            </div>

            <div class="info-value">

              {{internship.duration}}

            </div>

          </div>

        {{/if}}

        {{#if internship.startDate}}

          <div class="info-row">

            <div class="info-label">

              Expected Start Date

            </div>

            <div class="info-value">

              {{internship.startDate}}

            </div>

          </div>

        {{/if}}

        {{#if internship.numberOfPositions}}

          <div class="info-row">

            <div class="info-label">

              Available Positions

            </div>

            <div class="info-value">

              {{internship.numberOfPositions}}

            </div>

          </div>

        {{/if}}

      </section>

      <!-- Requirements -->

      {{#if internship.requirements}}

        <section class="content-card">

          <h2 class="section-title">

            Requirements & Eligibility

          </h2>

          <div class="internship-description">

            {{internship.requirements}}

          </div>

        </section>

      {{/if}}

      <!-- Responsibilities -->

      {{#if internship.responsibilities}}

        <section class="content-card">

          <h2 class="section-title">

            Responsibilities

          </h2>

          <div class="internship-description">

            {{internship.responsibilities}}

          </div>

        </section>

      {{/if}}

      <!-- Benefits -->

      {{#if internship.benefits}}

        <section class="content-card">

          <h2 class="section-title">

            Internship Benefits

          </h2>

          <div class="benefit-box">

            {{internship.benefits}}

          </div>

        </section>

      {{/if}}

      <!-- Compensation -->

      {{#if internship.compensationDetails}}

        <section class="content-card">

          <h2 class="section-title">

            Compensation

          </h2>

          <div class="internship-description">

            {{internship.compensationDetails}}

          </div>

        </section>

      {{/if}}

      <!-- How To Apply -->

      {{#if internship.applicationInstructions}}

        <section class="content-card">

          <h2 class="section-title">

            How to Apply

          </h2>

          <div class="internship-description">

            {{internship.applicationInstructions}}

          </div>

        </section>

      {{/if}}

      <!-- Source -->

      <section class="content-card">

        <h2 class="section-title">

          Internship Source

        </h2>

        <p class="text-muted mb-2">

          This internship information is published on ET24Jobs based on
          information provided by the original organization or source.

        </p>

        {{#if internship.sourceName}}

          <div class="mb-2">

            <i class="bi bi-link-45deg"></i>

            Source:

            <strong>

              {{internship.sourceName}}

            </strong>

          </div>

        {{/if}}

        {{#if internship.sourceUrl}}

          <a
            href="{{internship.sourceUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-primary mt-2"
          >

            <i class="bi bi-box-arrow-up-right"></i>

            Visit Original Source

          </a>

        {{/if}}

      </section>

    </div>

    <!-- =====================
             RIGHT SIDEBAR
        ====================== -->

    <div class="col-lg-4">

      <aside class="apply-card">

        <div class="apply-title">

          Apply for this Internship

        </div>

        <!-- Compensation -->

        {{#if internship.compensationType}}

          <div class="compensation-box mt-3">

            <i class="bi bi-cash-stack"></i>

            <strong>

              Compensation

            </strong>

            <br />

            {{internship.compensationType}}

            {{#if internship.compensationDetails}}

              <br />

              {{internship.compensationDetails}}

            {{/if}}

          </div>

        {{/if}}

        <!-- Duration -->

        {{#if internship.duration}}

          <div class="info-row">

            <div class="info-label">

              Duration

            </div>

            <div class="info-value">

              {{internship.duration}}

            </div>

          </div>

        {{/if}}

        <!-- Deadline -->

        {{#if internship.deadline}}

          <div class="deadline-box">

            <i class="bi bi-calendar-event"></i>

            <strong>

              Application Deadline

            </strong>

            <br />

            {{internship.deadline}}

          </div>

        {{/if}}

        <!-- Apply Button -->

        {{#if internship.applicationUrl}}

          <a
            href="{{internship.applicationUrl}}"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary apply-button"
          >

            Apply Now

            <i class="bi bi-arrow-right"></i>

          </a>

        {{else}}

          <div class="alert alert-warning">

            Application link is not currently available.

          </div>

        {{/if}}

        <div class="source-note">

          ET24Jobs does not guarantee internship placement. Applicants should
          verify the opportunity, eligibility requirements and application
          details with the original organization.

        </div>

      </aside>

      <!-- SIDEBAR AD -->

    </div>

  </div>

  <!-- =========================
         MIDDLE AD
    ========================= -->

  <!-- =========================
         RELATED INTERNSHIPS
    ========================= -->

  <section>

    <div class="d-flex justify-content-between align-items-center mb-4">

      <h2 class="section-title mb-0">

        Related Internships

      </h2>

      <a href="/internships" class="btn btn-outline-primary btn-sm">

        View All Internships

      </a>

    </div>

    <div class="row g-4">

      {{#each relatedInternships}}

        <div class="col-md-6 col-lg-4">

          <article class="related-card">

            <div class="d-flex gap-3">

              <div class="related-icon">

                <i class="bi bi-person-workspace"></i>

              </div>

              <div>

                <a href="/internships/{{slug}}" class="related-title">

                  {{title}}

                </a>

                <div class="related-organization mt-1">

                  <i class="bi bi-building"></i>

                  {{organizationName}}

                </div>

              </div>

            </div>

            <div class="related-info">

              {{#if fieldOfStudy}}

                <div class="mb-1">

                  <i class="bi bi-book"></i>

                  {{fieldOfStudy}}

                </div>

              {{/if}}

              {{#if studyLevel}}

                <div class="mb-1">

                  <i class="bi bi-mortarboard"></i>

                  {{studyLevel}}

                </div>

              {{/if}}

              {{#if location}}

                <div class="mb-1">

                  <i class="bi bi-geo-alt"></i>

                  {{location}}

                </div>

              {{/if}}

              {{#if deadline}}

                <div>

                  <i class="bi bi-calendar-event"></i>

                  Deadline:

                  {{deadline}}

                </div>

              {{/if}}

            </div>

            <div class="mt-3">

              <a
                href="/internships/{{slug}}"
                class="btn btn-sm btn-outline-primary"
              >

                View Internship

                <i class="bi bi-arrow-right"></i>

              </a>

            </div>

          </article>

        </div>

      {{/each}}

    </div>

  </section>

  <!-- =========================
         BOTTOM AD
    ========================= -->
</main>

<!-- =========================
     SHARE SCRIPT
========================= -->

<script>

  function shareInternship() { if (navigator.share) { navigator.share({ title: "{{internship.title}}
  | ET24Jobs", text: "Check out this internship opportunity on ET24Jobs.", url:
  window.location.href }); } else { navigator.clipboard.writeText(
  window.location.href ); alert( "Internship link copied to clipboard." ); } }

</script>