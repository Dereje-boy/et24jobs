<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {{! <title>Server Error | ET24Jobs</title> }}
    {{#if title}}
      {{!-- <p class="error-text"><strong>{{message}}</strong></p> --}}

      <title>{{title}}</title>
    {{else}}
      <title>Server Error | ET24Jobs</title>
    {{/if}}

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
    <style>
      body {
        background: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .navbar {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
      }

      .navbar-brand {
        font-size: 1.45rem;
        font-weight: 800;
        color: #2563eb !important;
      }

      .navbar-brand span {
        color: #111827;
      }

      .error-section {
        padding: 90px 20px 70px;
      }

      .error-code {
        font-size: 6rem;
        font-weight: 800;
        line-height: 1;
        color: #dc2626;
      }

      .error-title {
        font-size: 2rem;
        font-weight: 800;
        color: #111827;
        margin-top: 15px;
      }

      .error-text {
        max-width: 620px;
        margin: 15px auto 0;
        color: #6b7280;
        line-height: 1.7;
      }

      .error-stack {
        max-width: 900px;
        margin: 25px auto 0;
        text-align: left;
        background: #111827;
        color: #f9fafb;
        border-radius: 10px;
        padding: 20px;
        font-size: 0.85rem;
        overflow-x: auto;
        white-space: pre-wrap;
      }

      footer {
        background: #111827;
        color: #9ca3af;
        margin-top: 60px;
        padding: 45px 20px;
      }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg">
      <div class="container">
        <a class="navbar-brand" href="/">ET24<span>Jobs</span></a>
      </div>
    </nav>

    <section class="error-section text-center">
      <div class="container">
        <div class="error-code">500</div>

        <h1 class="error-title">Something Went Wrong</h1>

        <p class="error-text">
          An unexpected error occurred on our side. Please try again later or
          return to the home page.
        </p>

        {{#if message}}
          <p class="error-text"><strong>{{message}}</strong></p>
        {{/if}}

        {{#if stack}}
          <pre class="error-stack">{{stack}}</pre>
        {{/if}}

        <div class="mt-4">
          <a href="/" class="btn btn-primary me-2">
            <i class="bi bi-house-door me-1"></i>
            Back to Home
          </a>

          <a href="/jobs" class="btn btn-outline-primary">Browse Jobs</a>
        </div>
      </div>
    </section>

    <footer>
      <div class="container">
        <div class="text-center">
          <small>© 2026 ET24Jobs. All rights reserved.</small>
        </div>
      </div>
    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>
</html>