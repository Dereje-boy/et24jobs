<html lang="en">

  <head>

    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Jobs | ET24Jobs</title>

    <meta
      name="description"
      content="Find the latest jobs and employment opportunities on ET24Jobs."
    />

    <!-- Bootstrap -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- Bootstrap Icons -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />

    <style>
      body {
        background: #f5f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      /* =========================
           NAVBAR
        ========================= */

      .navbar {
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
      }

      .navbar-brand {
        font-size: 1.45rem;
        font-weight: 800;
        color: #2563eb !important;
      }

      .navbar-brand span {
        color: #111827;
      }

      .nav-link {
        color: #374151 !important;
        font-weight: 500;
        margin-left: 10px;
      }

      .nav-link:hover,
      .nav-link.active {
        color: #2563eb !important;
      }

      /* =========================
           HERO
        ========================= */

      .jobs-hero {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);

        color: white;

        padding: 55px 20px;

        border-radius: 0 0 25px 25px;
      }

      .jobs-hero h1 {
        font-size: 2.4rem;
        font-weight: 800;
      }

      .jobs-hero p {
        max-width: 650px;
        margin: 15px auto 0;
        opacity: 0.92;
        font-size: 1.05rem;
      }

      /* =========================
           SEARCH
        ========================= */

      .search-box {
        margin-top: -25px;
        position: relative;
        z-index: 5;
      }

      .search-card {
        background: white;
        border-radius: 15px;
        padding: 18px;

        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
      }

      .search-input {
        border: 1px solid #d1d5db;
        border-radius: 10px;
        height: 48px;
      }

      .search-button {
        height: 48px;
        border-radius: 10px;
        font-weight: 600;
      }

      /* =========================
           SECTION
        ========================= */

      .section-title {
        font-weight: 800;
        color: #111827;
      }

      .result-count {
        color: #6b7280;
      }

      /* =========================
           JOB CARD
        ========================= */

      .job-card {
        background: white;

        border: 1px solid #e5e7eb;

        border-radius: 15px;

        padding: 22px;

        height: 100%;

        transition:
          transform 0.2s ease,
          box-shadow 0.2s ease;
      }

      .job-card:hover {
        transform: translateY(-4px);

        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
      }

      .company-icon {
        width: 50px;
        height: 50px;

        border-radius: 12px;

        background: #eff6ff;

        color: #2563eb;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 1.35rem;

        flex-shrink: 0;
      }

      .job-title {
        font-size: 1.15rem;
        font-weight: 700;

        color: #111827;

        text-decoration: none;
      }

      .job-title:hover {
        color: #2563eb;
      }

      .company-name {
        color: #6b7280;
        font-size: 0.9rem;
      }

      /* =========================
           JOB BADGES
        ========================= */

      .job-badge {
        display: inline-block;

        font-size: 0.78rem;

        font-weight: 600;

        padding: 5px 9px;

        border-radius: 20px;

        background: #eff6ff;

        color: #1d4ed8;
      }

      .job-badge.location {
        background: #f3f4f6;
        color: #4b5563;
      }

      .job-badge.category {
        background: #f3e8ff;
        color: #7e22ce;
      }

      /* =========================
           INFO
        ========================= */

      .info-item {
        color: #4b5563;
        font-size: 0.88rem;
        margin-bottom: 7px;
      }

      .info-item i {
        width: 20px;
        color: #2563eb;
      }

      /* =========================
           DESCRIPTION
        ========================= */

      .job-description {
        color: #6b7280;

        font-size: 0.9rem;

        line-height: 1.55;

        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;

        overflow: hidden;
      }

      /* =========================
           DEADLINE
        ========================= */

      .deadline {
        border-top: 1px solid #e5e7eb;

        margin-top: 18px;
        padding-top: 15px;

        color: #6b7280;

        font-size: 0.88rem;
      }

      .deadline strong {
        color: #dc2626;
      }

      /* =========================
           BUTTON
        ========================= */

      .details-button {
        border-radius: 9px;

        font-weight: 600;

        padding: 9px 16px;
      }

      /* =========================
           ADVERTISEMENT
        ========================= */

      .ad-box {
        min-height: 90px;

        background: #ffffff;

        border: 1px dashed #d1d5db;

        border-radius: 12px;

        display: flex;

        align-items: center;

        justify-content: center;

        color: #9ca3af;

        font-size: 0.8rem;
      }

      /* =========================
           FOOTER
        ========================= */

      footer {
        background: #111827;

        color: #9ca3af;

        margin-top: 60px;

        padding: 40px 20px;
      }

      footer h5 {
        color: white;
        font-weight: 700;
      }

      footer a {
        color: #9ca3af;
        text-decoration: none;
      }

      footer a:hover {
        color: white;
      }

      /* =========================
           MOBILE
        ========================= */

      @media (max-width: 768px) {
        .jobs-hero {
          padding: 40px 20px;
        }

        .jobs-hero h1 {
          font-size: 1.9rem;
        }

        .search-box {
          margin-top: -15px;
        }
      }
    </style>

  </head>

  <body>

    <!-- =========================
     NAVBAR
========================= -->

    <nav class="navbar navbar-expand-lg">

      <div class="container">

        <a class="navbar-brand" href="/">
          ET24<span>Jobs</span>
        </a>

        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#mainNavbar"
          aria-controls="mainNavbar"
          aria-expanded="false"
          aria-label="Toggle navigation"
        >

          <span class="navbar-toggler-icon"></span>

        </button>

        <div class="collapse navbar-collapse" id="mainNavbar">

          <ul class="navbar-nav ms-auto">

            <li class="nav-item">

              <a class="nav-link" href="/">
                Home
              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link active" href="/jobs">
                Jobs
              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/scholarships">
                Scholarships
              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/internships">
                Internships
              </a>

            </li>

            <li class="nav-item">

              <a class="nav-link" href="/jobs/post">
                Post a Job
              </a>

            </li>

          </ul>

        </div>

      </div>

    </nav>

    <!-- =========================
     HERO
========================= -->

    <section class="jobs-hero text-center">

      <div class="container">

        <h1>
          Find Your Next Job
        </h1>

        <p>
          Discover the latest jobs and employment opportunities from
          organizations in Ethiopia and beyond.
        </p>

      </div>

    </section>

    <!-- =========================
     SEARCH
========================= -->

    <div class="container search-box">

      <div class="search-card">

        <form action="/jobs" method="GET">

          <div class="row g-2">

            <div class="col-md-9">

              <input
                type="search"
                name="q"
                class="form-control search-input"
                placeholder="Search jobs, companies, skills..."
                value="{{searchQuery}}"
              />

            </div>

            <div class="col-md-3">

              <button type="submit" class="btn btn-primary w-100 search-button">

                <i class="bi bi-search"></i>

                Search Jobs

              </button>

            </div>

          </div>

        </form>

      </div>

    </div>

    <!-- =========================
     MAIN CONTENT
========================= -->

    <main class="container my-5">

      <!-- Heading -->

      <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

          <h2 class="section-title mb-1">
            Latest Jobs
          </h2>

          <div class="result-count">

            Showing
            {{jobs.length}}
            job opportunities

          </div>

        </div>

      </div>

      <!-- =========================
         JOB CARDS
    ========================= -->

      <div class="row g-4">

        {{#each jobs}}

          <div class="col-lg-6">

            <article class="job-card">

              <!-- Header -->

              <div class="d-flex gap-3 mb-3">

                <div class="company-icon">

                  <i class="bi bi-briefcase-fill"></i>

                </div>

                <div class="flex-grow-1">

                  <a href="/jobs/{{slug}}" class="job-title">

                    {{title}}

                  </a>

                  <div class="company-name mt-1">

                    <i class="bi bi-building"></i>

                    {{companyName}}

                  </div>

                </div>

              </div>

              <!-- Badges -->

              <div class="mb-3">

                {{#if employmentType}}

                  <span class="job-badge">

                    <i class="bi bi-clock"></i>

                    {{employmentType}}

                  </span>

                {{/if}}

                {{#if location}}

                  <span class="job-badge location ms-1">

                    <i class="bi bi-geo-alt"></i>

                    {{location}}

                  </span>

                {{/if}}

                {{#if categoryName}}

                  <span class="job-badge category ms-1">

                    {{categoryName}}

                  </span>

                {{/if}}

              </div>

              <!-- Job Information -->

              <div>

                {{#if salary}}

                  <div class="info-item">

                    <i class="bi bi-cash-stack"></i>

                    {{salary}}

                  </div>

                {{/if}}

                {{#if qualifications}}

                  <div class="info-item">

                    <i class="bi bi-mortarboard"></i>

                    {{qualifications}}

                  </div>

                {{/if}}

                {{#if location}}

                  <div class="info-item">

                    <i class="bi bi-pin-map"></i>

                    {{location}}

                  </div>

                {{/if}}

              </div>

              <!-- Description -->

              {{#if description}}

                <p class="job-description mt-3 mb-0">

                  {{description}}

                </p>

              {{/if}}

              <!-- Deadline -->

              <div class="deadline">

                <i class="bi bi-calendar-event"></i>

                Application deadline:

                {{#if deadline}}

                  <strong>
                    {{deadline}}
                  </strong>

                {{else}}

                  <strong>
                    Not specified
                  </strong>

                {{/if}}

              </div>

              <!-- Button -->

              <div class="mt-3">

                <a href="/jobs/{{slug}}" class="btn btn-primary details-button">

                  View Job

                  <i class="bi bi-arrow-right"></i>

                </a>

              </div>

            </article>

          </div>

        {{/each}}

      </div>

      <!-- Empty State -->

      {{#unless jobs.length}}

        <div class="text-center py-5">

          <div class="mb-3">

            <i
              class="bi bi-briefcase"
              style="font-size: 3rem; color: #9ca3af;"
            ></i>

          </div>

          <h4>
            No jobs found
          </h4>

          <p class="text-muted">
            Try searching with a different keyword.
          </p>

        </div>

      {{/unless}}

    </main>

    <!-- =========================
     FOOTER
========================= -->

    <footer>

      <div class="container">

        <div class="row g-4">

          <div class="col-md-5">

            <h5>
              ET24Jobs
            </h5>

            <p class="mt-3">

              Find jobs, scholarships and internships in Ethiopia and around the
              world.

            </p>

          </div>

          <div class="col-md-3">

            <h5>
              Explore
            </h5>

            <ul class="list-unstyled mt-3">

              <li class="mb-2">

                <a href="/jobs">
                  Jobs
                </a>

              </li>

              <li class="mb-2">

                <a href="/scholarships">
                  Scholarships
                </a>

              </li>

              <li>

                <a href="/internships">
                  Internships
                </a>

              </li>

            </ul>

          </div>

          <div class="col-md-4">

            <h5>
              ET24Jobs
            </h5>

            <p class="mt-3">

              Helping job seekers discover new employment opportunities.

            </p>

          </div>

        </div>

        <hr class="border-secondary my-4" />

        <div class="text-center">

          <small>
            © 2026 ET24Jobs. All rights reserved.
          </small>

        </div>

      </div>

    </footer>

    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

  </body>

</html>