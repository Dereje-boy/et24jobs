<!-- ==========================================
     PAGE HEADER
=========================================== -->

    <section class="page-header text-center">

      <div class="container">

        <h1 class="page-title">

          Create Job

        </h1>

        <p class="page-subtitle">

          Add a new employment opportunity to the ET24Jobs job directory.

        </p>

      </div>

    </section>

    <main class="container my-5">

      <div class="row g-4">

        <!-- =====================================
             MAIN FORM
        ====================================== -->

        <div class="col-lg-8">

          <div class="form-card">

            <form
              id="createJobForm"
              action="/jobs/create/"
              method="POST"
              enctype="multipart/form-data"
            >

              {{#if errors}}
                <div class="alert alert-danger" role="alert">
                  <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Please fix the following errors:
                  </h5>
                  <ul class="mb-0">
                    {{#each errors}}
                      <li>{{this}}</li>
                    {{/each}}
                  </ul>
                </div>
              {{/if}}

              <!-- =================================
                         BASIC INFORMATION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-info-circle"></i>

                  Basic Information

                </h2>

                <div class="row g-3">

                  <!-- Job Title -->

                  <div class="col-12">

                    <label for="title" class="form-label">

                      Job Title

                      <span class="required">
                        *
                      </span>

                    </label>

                    <input
                      type="text"
                      id="title"
                      name="title"
                      class="form-control {{#if errors.title}}is-invalid{{/if}}"
                      placeholder="e.g. Junior Software Developer"
                      value="{{formData.title}}"
                      required
                    />
                    {{#if errors.title}}
                      <div class="invalid-feedback">
                        {{errors.title}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Organization -->

                  <div class="col-md-6">

                    <label for="organization" class="form-label">

                      Organization

                      <span class="required">
                        *
                      </span>

                    </label>

                    <input
                      type="text"
                      id="organization"
                      name="organization"
                      class="form-control {{#if errors.organization}}is-invalid{{/if}}"
                      placeholder="Company / Organization name"
                      value="{{formData.organization}}"
                      required
                    />
                    {{#if errors.organization}}
                      <div class="invalid-feedback">
                        {{errors.organization}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Category -->

                  <div class="col-md-6">

                    <label for="categoryId" class="form-label">

                      Category

                      <span class="required">
                        *
                      </span>

                    </label>

                    <select
                      id="categoryId"
                      name="categoryId"
                      class="form-select {{#if errors.categoryId}}is-invalid{{/if}}"
                    >

                      <option value="" selected>
                        Select category
                      </option>

                      {{#each categories}}

                        <option value="{{this.id}}" {{#if (eqLoose ../formData.categoryId this.id)}}selected{{/if}}>
                          {{this.name}}
                        </option>

                      {{/each}}

                    </select>
                    {{#if errors.categoryId}}
                      <div class="invalid-feedback">
                        {{errors.categoryId}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Location -->

                  <div class="col-md-6">

                    <label for="location" class="form-label">

                      Location

                    </label>

                    <input
                      type="text"
                      id="location"
                      name="location"
                      class="form-control {{#if errors.location}}is-invalid{{/if}}"
                      placeholder="e.g. Addis Ababa (defaults to Ethiopia)"
                      value="{{formData.location}}"
                    />
                    {{#if errors.location}}
                      <div class="invalid-feedback">
                        {{errors.location}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Employment Type -->

                  <div class="col-md-6">

                    <label for="employmentType" class="form-label">

                      Employment Type

                    </label>

                    <select
                      id="employmentType"
                      name="employmentType"
                      class="form-select {{#if errors.employmentType}}is-invalid{{/if}}"
                    >

                      <option value="full-time" {{#if (eqLoose formData.employmentType "full-time")}}selected{{/if}}>
                        Full-time
                      </option>

                      <option value="part-time" {{#if (eqLoose formData.employmentType "part-time")}}selected{{/if}}>
                        Part-time
                      </option>

                      <option value="contract" {{#if (eqLoose formData.employmentType "contract")}}selected{{/if}}>
                        Contract
                      </option>

                      <option value="temporary" {{#if (eqLoose formData.employmentType "temporary")}}selected{{/if}}>
                        Temporary
                      </option>

                      <option value="internship" {{#if (eqLoose formData.employmentType "internship")}}selected{{/if}}>
                        Internship
                      </option>

                      <option value="volunteer" {{#if (eqLoose formData.employmentType "volunteer")}}selected{{/if}}>
                        Volunteer
                      </option>

                    </select>
                    {{#if errors.employmentType}}
                      <div class="invalid-feedback">
                        {{errors.employmentType}}
                      </div>
                    {{/if}}

                  </div>

                  <div class="col-md-6">

                    <label for="location" class="form-label">

                      Slug

                    </label>

                    <input
                      type="text"
                      id="slug"
                      name="slug"
                      class="form-control {{#if errors.slug}}is-invalid{{/if}}"
                      placeholder="e.g. addis-ababa-financial-analyst-123456789"
                      value="{{formData.slug}}"
                    />
                    {{#if errors.slug}}
                      <div class="invalid-feedback">
                        {{errors.slug}}
                      </div>
                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         JOB DETAILS
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-briefcase"></i>

                  Job Details

                </h2>

                <div class="row g-3">

                  <!-- Salary -->

                  <div class="col-md-6">

                    <label for="salary" class="form-label">

                      Salary

                    </label>

                    <input
                      type="text"
                      id="salary"
                      name="salary"
                      class="form-control {{#if errors.salary}}is-invalid{{/if}}"
                      placeholder="e.g. Negotiable / 15,000 ETB"
                      value="{{formData.salary}}"
                    />
                    {{#if errors.salary}}
                      <div class="invalid-feedback">
                        {{errors.salary}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Deadline -->

                  <div class="col-md-6">

                    <label for="deadline" class="form-label">

                      Application Deadline

                    </label>

                    <input
                      type="date"
                      id="deadline"
                      name="deadline"
                      class="form-control {{#if errors.deadline}}is-invalid{{/if}}"
                      value="{{formData.deadline}}"
                    />
                    {{#if errors.deadline}}
                      <div class="invalid-feedback">
                        {{errors.deadline}}
                      </div>
                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         DESCRIPTION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-file-text"></i>

                  Job Description

                </h2>

                <!-- Description -->

                <div class="mb-4">

                  <label for="description" class="form-label">

                    Description

                    <span class="required">
                      *
                    </span>

                  </label>

                  <textarea
                    id="description"
                    name="description"
                    class="form-control {{#if errors.description}}is-invalid{{/if}}"
                    rows="8"
                    placeholder="Provide a detailed description of the job..."
                    required
                  >{{formData.description}}</textarea>
                  {{#if errors.description}}
                    <div class="invalid-feedback">
                      {{errors.description}}
                    </div>
                  {{/if}}

                </div>

                <!-- Responsibilities -->

                <div class="mb-4">

                  <label for="responsibilities" class="form-label">

                    Responsibilities

                  </label>

                  <textarea
                    id="responsibilities"
                    name="responsibilities"
                    class="form-control {{#if errors.responsibilities}}is-invalid{{/if}}"
                    rows="7"
                    placeholder="List the main responsibilities of the position..."
                  >{{formData.responsibilities}}</textarea>
                  {{#if errors.responsibilities}}
                    <div class="invalid-feedback">
                      {{errors.responsibilities}}
                    </div>
                  {{/if}}

                  <div class="form-text mt-2">

                    You can separate individual responsibilities using new
                    lines.

                  </div>

                </div>

                <!-- Requirements -->

                <div>

                  <label for="requirements" class="form-label">

                    Requirements

                  </label>

                  <textarea
                    id="requirements"
                    name="requirements"
                    class="form-control {{#if errors.requirements}}is-invalid{{/if}}"
                    rows="7"
                    placeholder="List education, skills, experience and other requirements..."
                  >{{formData.requirements}}</textarea>
                  {{#if errors.requirements}}
                    <div class="invalid-feedback">
                      {{errors.requirements}}
                    </div>
                  {{/if}}

                </div>

              </div>

              <!-- =================================
                         ATTACHMENTS
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-paperclip"></i>

                  Attachments

                </h2>

                {{#if errors.attachments}}

                  <div class="alert alert-danger py-2">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    {{errors.attachments}}

                  </div>

                {{/if}}

                <div
                  id="dropzone"
                  class="dropzone"
                  tabindex="0"
                  role="button"
                  aria-label="Choose files to attach"
                >

                  <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>

                  <p class="mb-1 fw-semibold">

                    Drag &amp; drop files here, or <span class="text-primary">browse</span>

                  </p>

                  <p class="form-text mb-0">

                    Any file type. Up to 5 files, 10 MB each.

                    Files are attached to the job and submitted with the form.

                  </p>

                  <input
                    type="file"
                    id="attachments"
                    name="attachments"
                    multiple
                    hidden
                  />

                </div>

                <div id="fileList" class="row g-3 mt-1"></div>

              </div>

              <!-- =================================
                         APPLICATION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-box-arrow-up-right"></i>

                  Application Information

                </h2>

                <div class="row g-3">

                  <!-- Application URL -->

                  <div class="col-12">

                    <label for="applicationUrl" class="form-label">

                      Application URL

                    </label>

                    <input
                      type="url"
                      id="applicationUrl"
                      name="applicationUrl"
                      class="form-control {{#if errors.applicationUrl}}is-invalid{{/if}}"
                      placeholder="https://example.com/apply"
                      value="{{formData.applicationUrl}}"
                    />
                    {{#if errors.applicationUrl}}
                      <div class="invalid-feedback">
                        {{errors.applicationUrl}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Application Instructions -->

                  <div class="col-12">

                    <label for="applicationInstructions" class="form-label">

                      Application Instructions

                    </label>

                  <textarea
                    id="applicationInstructions"
                    name="applicationInstructions"
                    class="form-control {{#if errors.applicationInstructions}}is-invalid{{/if}}"
                    rows="5"
                    placeholder="Explain how applicants should apply for this job..."
                  >{{formData.applicationInstructions}}</textarea>
                  {{#if errors.applicationInstructions}}
                    <div class="invalid-feedback">
                      {{errors.applicationInstructions}}
                    </div>
                  {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         SOURCE
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-link-45deg"></i>

                  Original Source

                </h2>

                <div class="source-note mb-4">

                  <i class="bi bi-info-circle-fill"></i>

                  Since ET24Jobs publishes opportunities collected from external
                  sources, provide the original source whenever possible. This
                  helps visitors verify the opportunity.

                </div>

                <div class="row g-3">

                  <!-- Source Name -->

                  <div class="col-md-6">

                    <label for="sourceName" class="form-label">

                      Source / Provider

                    </label>

                    <input
                      type="text"
                      id="sourceName"
                      name="sourceName"
                      class="form-control {{#if errors.sourceName}}is-invalid{{/if}}"
                      placeholder="e.g. Company website"
                      value="{{formData.sourceName}}"
                    />
                    {{#if errors.sourceName}}
                      <div class="invalid-feedback">
                        {{errors.sourceName}}
                      </div>
                    {{/if}}

                  </div>

                  <!-- Source URL -->

                  <div class="col-md-6">

                    <label for="sourceUrl" class="form-label">

                      Original Source URL

                    </label>

                    <input
                      type="url"
                      id="sourceUrl"
                      name="sourceUrl"
                      class="form-control {{#if errors.sourceUrl}}is-invalid{{/if}}"
                      placeholder="https://original-source.com/job"
                      value="{{formData.sourceUrl}}"
                    />
                    {{#if errors.sourceUrl}}
                      <div class="invalid-feedback">
                        {{errors.sourceUrl}}
                      </div>
                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         PUBLISHING
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-send"></i>

                  Publishing

                </h2>

                <div class="row g-3">

                  <!-- Status -->

                  <div class="col-md-6">

                    <label for="status" class="form-label">

                      Status

                    </label>

                    <select id="status" name="status" class="form-select {{#if errors.status}}is-invalid{{/if}}">
                      <option value="published" {{#if (eqLoose formData.status "published")}}selected{{/if}}>
                        Published
                      </option>

                      <option value="draft" {{#if (eqLoose formData.status "draft")}}selected{{/if}}>
                        Draft
                      </option>

                    </select>
                    {{#if errors.status}}
                      <div class="invalid-feedback">
                        {{errors.status}}
                      </div>
                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         FORM ACTIONS
                    ================================== -->

              <div class="d-flex flex-wrap gap-2 justify-content-end">

                <button type="reset" class="btn btn-outline-secondary">

                  <i class="bi bi-arrow-counterclockwise"></i>

                  Reset

                </button>

                <button type="submit" class="btn btn-primary">

                  <i class="bi bi-plus-lg"></i>

                  Create Job

                </button>

              </div>

            </form>

          </div>

        </div>

        <!-- =====================================
             SIDEBAR
        ====================================== -->

        <div class="col-lg-4">

          <!-- Posting Guide -->

          <div class="side-card">

            <h3 class="side-heading">

              <i class="bi bi-lightbulb"></i>

              Job Posting Guide

            </h3>

            <div class="info-item">

              <i class="bi bi-check-circle-fill"></i>

              <span>
                Use the official job title used by the organization.
              </span>

            </div>

            <div class="info-item">

              <i class="bi bi-check-circle-fill"></i>

              <span>
                Make sure the organization name is accurate.
              </span>

            </div>

            <div class="info-item">

              <i class="bi bi-check-circle-fill"></i>

              <span>
                Include important education, experience and skill requirements.
              </span>

            </div>

            <div class="info-item">

              <i class="bi bi-check-circle-fill"></i>

              <span>
                Verify the application deadline before publishing.
              </span>

            </div>

            <div class="info-item">

              <i class="bi bi-check-circle-fill"></i>

              <span>
                Always check the application URL.
              </span>

            </div>

          </div>

          <!-- Source Information -->

          <div class="side-card">

            <h3 class="side-heading">

              <i class="bi bi-shield-check"></i>

              Keep Information Genuine

            </h3>

            <p class="text-muted" style="font-size: .9rem; line-height: 1.7;">

              ET24Jobs aims to help visitors discover genuine employment
              opportunities. Whenever possible, keep the original organization
              name, job title, deadline and application source unchanged.

            </p>

            <div class="source-note">

              <i class="bi bi-link-45deg"></i>

              The original source URL can be displayed on the job detail page so
              applicants can verify the opportunity.

            </div>

          </div>

        </div>

      </div>

    </main>

<script>
      window.JOB_VALIDATION = {{{json jobValidationJson}}};
    </script>

<script src="/js/jobs/validation.js"></script>

<script src="/js/jobs/createjobs.js">
    </script>
