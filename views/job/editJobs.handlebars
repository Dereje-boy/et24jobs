<!-- ==========================================
     PAGE HEADER
=========================================== -->

    <section class="page-header text-center">

      <div class="container">

        <h1 class="page-title">

          Edit Job

        </h1>

        <p class="page-subtitle">

          Update "{{job.title}}" and its attachments.

        </p>

      </div>

    </section>

    <main class="container my-5">

      <div class="row g-4">

        <!-- =====================================
             MAIN FORM
        ====================================== -->

        <div class="col-lg-8">

          <div class="form-card">

            <form
              action="/jobs/{{job.id}}/edit"
              method="POST"
              enctype="multipart/form-data"
            >

              {{#if errors}}

                <div class="alert alert-danger" role="alert">

                  <h5 class="alert-heading">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    Please fix the following errors:

                  </h5>

                  <ul class="mb-0">

                    {{#each errors}}

                      <li>{{this}}</li>

                    {{/each}}

                  </ul>

                </div>

              {{/if}}

              <!-- =================================
                         BASIC INFORMATION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-info-circle"></i>

                  Basic Information

                </h2>

                <div class="row g-3">

                  <!-- Job Title -->

                  <div class="col-12">

                    <label for="title" class="form-label">

                      Job Title

                      <span class="required">
                        *
                      </span>

                    </label>

                    <input
                      type="text"
                      id="title"
                      name="title"
                      class="form-control {{#if errors.title}}is-invalid{{/if}}"
                      placeholder="e.g. Junior Software Developer"
                      value="{{coalesce formData.title job.title}}"
                      required
                    />

                    {{#if errors.title}}

                      <div class="invalid-feedback">
                        {{errors.title}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Organization -->

                  <div class="col-md-6">

                    <label for="organization" class="form-label">

                      Organization

                      <span class="required">
                        *
                      </span>

                    </label>

                    <input
                      type="text"
                      id="organization"
                      name="organization"
                      class="form-control {{#if errors.organization}}is-invalid{{/if}}"
                      placeholder="Company / Organization name"
                      value="{{coalesce formData.organization job.companyName}}"
                      required
                    />

                    {{#if errors.organization}}

                      <div class="invalid-feedback">
                        {{errors.organization}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Category -->

                  <div class="col-md-6">

                    <label for="categoryId" class="form-label">

                      Category

                      <span class="required">
                        *
                      </span>

                    </label>

                    <select
                      id="categoryId"
                      name="categoryId"
                      class="form-select {{#if errors.categoryId}}is-invalid{{/if}}"
                    >

                      <option value="">
                        Select category
                      </option>

                      {{#each categories}}

                        <option
                          value="{{this.id}}"
                          {{#if (eqLoose (coalesce ../formData.categoryId ../job.categoryId) this.id)}}selected{{/if}}
                        >
                          {{this.name}}
                        </option>

                      {{/each}}

                    </select>

                    {{#if errors.categoryId}}

                      <div class="invalid-feedback">
                        {{errors.categoryId}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Location -->

                  <div class="col-md-6">

                    <label for="location" class="form-label">

                      Location

                    </label>

                    <input
                      type="text"
                      id="location"
                      name="location"
                      class="form-control {{#if errors.location}}is-invalid{{/if}}"
                      placeholder="e.g. Addis Ababa (defaults to Ethiopia)"
                      value="{{coalesce formData.location job.location}}"
                    />

                    {{#if errors.location}}

                      <div class="invalid-feedback">
                        {{errors.location}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Employment Type -->

                  <div class="col-md-6">

                    <label for="employmentType" class="form-label">

                      Employment Type

                    </label>

                    <select
                      id="employmentType"
                      name="employmentType"
                      class="form-select {{#if errors.employmentType}}is-invalid{{/if}}"
                    >

                      <option value="full-time" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "full-time")}}selected{{/if}}>
                        Full-time
                      </option>

                      <option value="part-time" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "part-time")}}selected{{/if}}>
                        Part-time
                      </option>

                      <option value="contract" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "contract")}}selected{{/if}}>
                        Contract
                      </option>

                      <option value="temporary" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "temporary")}}selected{{/if}}>
                        Temporary
                      </option>

                      <option value="internship" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "internship")}}selected{{/if}}>
                        Internship
                      </option>

                      <option value="volunteer" {{#if (eqLoose (coalesce formData.employmentType job.employmentType) "volunteer")}}selected{{/if}}>
                        Volunteer
                      </option>

                    </select>

                    {{#if errors.employmentType}}

                      <div class="invalid-feedback">
                        {{errors.employmentType}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Slug -->

                  <div class="col-md-6">

                    <label for="slug" class="form-label">

                      Slug

                    </label>

                    <input
                      type="text"
                      id="slug"
                      name="slug"
                      class="form-control {{#if errors.slug}}is-invalid{{/if}}"
                      placeholder="Leave empty to keep the current slug"
                      value="{{coalesce formData.slug job.slug}}"
                    />

                    {{#if errors.slug}}

                      <div class="invalid-feedback">
                        {{errors.slug}}
                      </div>

                    {{/if}}

                    <div class="form-text mt-2">

                      Empty keeps the current slug. A duplicate slug is
                      rejected.

                    </div>

                  </div>

                </div>

              </div>

              <!-- =================================
                         JOB DETAILS
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-briefcase"></i>

                  Job Details

                </h2>

                <div class="row g-3">

                  <!-- Salary -->

                  <div class="col-md-6">

                    <label for="salary" class="form-label">

                      Salary

                    </label>

                    <input
                      type="text"
                      id="salary"
                      name="salary"
                      class="form-control {{#if errors.salary}}is-invalid{{/if}}"
                      placeholder="e.g. Negotiable / 15,000 ETB"
                      value="{{coalesce formData.salary job.salary}}"
                    />

                    {{#if errors.salary}}

                      <div class="invalid-feedback">
                        {{errors.salary}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Deadline -->

                  <div class="col-md-6">

                    <label for="deadline" class="form-label">

                      Application Deadline

                    </label>

                    <input
                      type="date"
                      id="deadline"
                      name="deadline"
                      class="form-control {{#if errors.deadline}}is-invalid{{/if}}"
                      value="{{coalesce formData.deadline job.deadline}}"
                    />

                    {{#if errors.deadline}}

                      <div class="invalid-feedback">
                        {{errors.deadline}}
                      </div>

                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         DESCRIPTION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-file-text"></i>

                  Job Description

                </h2>

                <!-- Description -->

                <div class="mb-4">

                  <label for="description" class="form-label">

                    Description

                    <span class="required">
                      *
                    </span>

                  </label>

                  <textarea
                    id="description"
                    name="description"
                    class="form-control {{#if errors.description}}is-invalid{{/if}}"
                    rows="8"
                    placeholder="Provide a detailed description of the job..."
                    required
                  >{{coalesce formData.description job.description}}</textarea>

                  {{#if errors.description}}

                    <div class="invalid-feedback">
                      {{errors.description}}
                    </div>

                  {{/if}}

                </div>

                <!-- Responsibilities -->

                <div class="mb-4">

                  <label for="responsibilities" class="form-label">

                    Responsibilities

                  </label>

                  <textarea
                    id="responsibilities"
                    name="responsibilities"
                    class="form-control {{#if errors.responsibilities}}is-invalid{{/if}}"
                    rows="7"
                    placeholder="List the main responsibilities of the position..."
                  >{{coalesce formData.responsibilities job.responsibilities}}</textarea>

                  {{#if errors.responsibilities}}

                    <div class="invalid-feedback">
                      {{errors.responsibilities}}
                    </div>

                  {{/if}}

                  <div class="form-text mt-2">

                    You can separate individual responsibilities using new
                    lines.

                  </div>

                </div>

                <!-- Requirements -->

                <div>

                  <label for="requirements" class="form-label">

                    Requirements

                  </label>

                  <textarea
                    id="requirements"
                    name="requirements"
                    class="form-control {{#if errors.requirements}}is-invalid{{/if}}"
                    rows="7"
                    placeholder="List education, skills, experience and other requirements..."
                  >{{coalesce formData.requirements job.requirements}}</textarea>

                  {{#if errors.requirements}}

                    <div class="invalid-feedback">
                      {{errors.requirements}}
                    </div>

                  {{/if}}

                </div>

              </div>

              <!-- =================================
                         ATTACHMENTS
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-paperclip"></i>

                  Attachments

                </h2>

                {{#if errors.attachments}}

                  <div class="alert alert-danger py-2">

                    <i class="bi bi-exclamation-triangle-fill"></i>

                    {{errors.attachments}}

                  </div>

                {{/if}}

                <!-- Existing attachments: per-file Published / Draft / Delete -->

                {{#if job.attachments.length}}

                  <p class="form-label mb-2">

                    Existing files
                    <span class="form-text d-inline">
                      (choose Published, Draft or Delete for each file, then
                      save)
                    </span>

                  </p>

                  <div class="row g-3 mb-4">

                    {{#each job.attachments}}

                      <div class="col-6 col-md-4">

                        <div
                          class="existing-file {{#if (eqLoose (coalesce (lookup ../formData.attachmentStates this.id) this.status) "delete")}}marked-remove{{/if}}"
                        >

                          {{#if this.isImage}}

                            <img
                              class="file-thumb"
                              src="/uploads/jobs/{{this.storedName}}"
                              alt="{{this.originalName}}"
                            />

                          {{else}}

                            <div class="file-thumb-placeholder">
                              <i class="bi bi-file-earmark"></i>
                            </div>

                          {{/if}}

                          <div class="file-name mt-2" title="{{this.originalName}}">
                            {{this.originalName}}
                          </div>

                          <small class="text-muted">
                            {{formatBytes this.sizeBytes}}
                          </small>

                          <div
                            class="btn-group btn-group-sm att-state-group"
                            role="group"
                            aria-label="Visibility of {{this.originalName}}"
                          >

                            <input
                              type="radio"
                              class="btn-check"
                              name="attachmentStates[{{this.id}}]"
                              id="att-{{this.id}}-published"
                              value="published"
                              {{#if (eqLoose (coalesce (lookup ../formData.attachmentStates this.id) this.status) "published")}}checked{{/if}}
                            />

                            <label
                              class="btn btn-outline-primary"
                              for="att-{{this.id}}-published"
                            >
                              <i class="bi bi-eye"></i>
                              Published
                            </label>

                            <input
                              type="radio"
                              class="btn-check"
                              name="attachmentStates[{{this.id}}]"
                              id="att-{{this.id}}-draft"
                              value="draft"
                              {{#if (eqLoose (coalesce (lookup ../formData.attachmentStates this.id) this.status) "draft")}}checked{{/if}}
                            />

                            <label
                              class="btn btn-outline-secondary"
                              for="att-{{this.id}}-draft"
                            >
                              <i class="bi bi-eye-slash"></i>
                              Draft
                            </label>

                            <input
                              type="radio"
                              class="btn-check"
                              name="attachmentStates[{{this.id}}]"
                              id="att-{{this.id}}-delete"
                              value="delete"
                              {{#if (eqLoose (coalesce (lookup ../formData.attachmentStates this.id) this.status) "delete")}}checked{{/if}}
                            />

                            <label
                              class="btn btn-outline-danger"
                              for="att-{{this.id}}-delete"
                            >
                              <i class="bi bi-trash"></i>
                              Delete
                            </label>

                          </div>

                        </div>

                      </div>

                    {{/each}}

                  </div>

                {{/if}}

                <!-- Add new files -->

                <div
                  id="dropzone"
                  class="dropzone"
                  tabindex="0"
                  role="button"
                  aria-label="Choose files to attach"
                >

                  <i class="bi bi-cloud-arrow-up fs-1 text-primary"></i>

                  <p class="mb-1 fw-semibold">

                    Drag &amp; drop new files here, or
                    <span class="text-primary">browse</span>

                  </p>

                  <p class="form-text mb-0">

                    Any file type. Up to 5 files, 10 MB each.

                  </p>

                  <input
                    type="file"
                    id="attachments"
                    name="attachments"
                    multiple
                    hidden
                  />

                </div>

                <div id="fileList" class="row g-3 mt-1"></div>

              </div>

              <!-- =================================
                         APPLICATION
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-box-arrow-up-right"></i>

                  Application Information

                </h2>

                <div class="row g-3">

                  <!-- Application URL -->

                  <div class="col-12">

                    <label for="applicationUrl" class="form-label">

                      Application URL

                    </label>

                    <input
                      type="url"
                      id="applicationUrl"
                      name="applicationUrl"
                      class="form-control {{#if errors.applicationUrl}}is-invalid{{/if}}"
                      placeholder="https://example.com/apply"
                      value="{{coalesce formData.applicationUrl job.applicationUrl}}"
                    />

                    {{#if errors.applicationUrl}}

                      <div class="invalid-feedback">
                        {{errors.applicationUrl}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Application Email -->

                  <div class="col-12">

                    <label for="applicationEmail" class="form-label">

                      Application Email

                    </label>

                    <input
                      type="email"
                      id="applicationEmail"
                      name="applicationEmail"
                      class="form-control {{#if errors.applicationEmail}}is-invalid{{/if}}"
                      placeholder="hr@example.com"
                      value="{{coalesce formData.applicationEmail job.applicationEmail}}"
                    />

                    {{#if errors.applicationEmail}}

                      <div class="invalid-feedback">
                        {{errors.applicationEmail}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Application Instructions -->

                  <div class="col-12">

                    <label for="applicationInstructions" class="form-label">

                      Application Instructions

                    </label>

                    <textarea
                      id="applicationInstructions"
                      name="applicationInstructions"
                      class="form-control {{#if errors.applicationInstructions}}is-invalid{{/if}}"
                      rows="5"
                      placeholder="Explain how applicants should apply for this job..."
                    >{{coalesce formData.applicationInstructions job.applicationInstructions}}</textarea>

                    {{#if errors.applicationInstructions}}

                      <div class="invalid-feedback">
                        {{errors.applicationInstructions}}
                      </div>

                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         SOURCE
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-link-45deg"></i>

                  Original Source

                </h2>

                <div class="source-note mb-4">

                  <i class="bi bi-info-circle-fill"></i>

                  Since ET24Jobs publishes opportunities collected from external
                  sources, provide the original source whenever possible. This
                  helps visitors verify the opportunity.

                </div>

                <div class="row g-3">

                  <!-- Source Name -->

                  <div class="col-md-6">

                    <label for="sourceName" class="form-label">

                      Source / Provider

                    </label>

                    <input
                      type="text"
                      id="sourceName"
                      name="sourceName"
                      class="form-control {{#if errors.sourceName}}is-invalid{{/if}}"
                      placeholder="e.g. Company website"
                      value="{{coalesce formData.sourceName job.sourceName}}"
                    />

                    {{#if errors.sourceName}}

                      <div class="invalid-feedback">
                        {{errors.sourceName}}
                      </div>

                    {{/if}}

                  </div>

                  <!-- Source URL -->

                  <div class="col-md-6">

                    <label for="sourceUrl" class="form-label">

                      Original Source URL

                    </label>

                    <input
                      type="url"
                      id="sourceUrl"
                      name="sourceUrl"
                      class="form-control {{#if errors.sourceUrl}}is-invalid{{/if}}"
                      placeholder="https://original-source.com/job"
                      value="{{coalesce formData.sourceUrl job.sourceUrl}}"
                    />

                    {{#if errors.sourceUrl}}

                      <div class="invalid-feedback">
                        {{errors.sourceUrl}}
                      </div>

                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         PUBLISHING
                    ================================== -->

              <div class="form-section">

                <h2 class="section-heading">

                  <i class="bi bi-send"></i>

                  Publishing

                </h2>

                <div class="row g-3">

                  <!-- Status -->

                  <div class="col-md-6">

                    <label for="status" class="form-label">

                      Status

                    </label>

                    <select
                      id="status"
                      name="status"
                      class="form-select {{#if errors.status}}is-invalid{{/if}}"
                    >

                      <option value="published" {{#if (eqLoose (coalesce formData.status job.status) "published")}}selected{{/if}}>
                        Published
                      </option>

                      <option value="draft" {{#if (eqLoose (coalesce formData.status job.status) "draft")}}selected{{/if}}>
                        Draft
                      </option>

                    </select>

                    {{#if errors.status}}

                      <div class="invalid-feedback">
                        {{errors.status}}
                      </div>

                    {{/if}}

                  </div>

                </div>

              </div>

              <!-- =================================
                         FORM ACTIONS
                    ================================== -->

              <div class="d-flex flex-wrap gap-2 justify-content-end">

                <a href="/jobs/{{job.slug}}" class="btn btn-outline-secondary">

                  <i class="bi bi-x-lg"></i>

                  Cancel

                </a>

                <button type="submit" class="btn btn-primary">

                  <i class="bi bi-check-lg"></i>

                  Save Changes

                </button>

              </div>

            </form>

          </div>

        </div>

        <!-- =====================================
             SIDEBAR
        ====================================== -->

        <div class="col-lg-4">

          <div class="side-card">

            <h3 class="side-heading">

              <i class="bi bi-lightbulb"></i>

              Editing Tips

            </h3>

            <div class="source-note">

              <i class="bi bi-info-circle-fill"></i>

              Files set to Delete are removed when you save. Draft files stay
              on the server but are hidden from the public job page. New files
              are uploaded with the save. Changes are applied in one
              transaction - either everything saves or nothing does.

            </div>

          </div>

          <div class="side-card">

            <h3 class="side-heading">

              <i class="bi bi-link-45deg"></i>

              Public Page

            </h3>

            <p class="text-muted" style="font-size: .9rem; line-height: 1.7;">

              The job is live at
              <a href="/jobs/{{job.slug}}">/jobs/{{job.slug}}</a>.
              Changing the slug changes this public URL.

            </p>

          </div>

        </div>

      </div>

    </main>

<script>
      window.JOB_VALIDATION = {{{json jobValidationJson}}};

      // The job's current deadline: the client validator allows an unchanged
      // (possibly past) deadline on edit, mirroring the server rule.
      window.JOB_EDIT = {
        currentDeadline: {{{json job.deadline}}},
      };
    </script>

<script src="/js/jobs/validation.js"></script>

<script src="/js/jobs/editjob.js"></script>
